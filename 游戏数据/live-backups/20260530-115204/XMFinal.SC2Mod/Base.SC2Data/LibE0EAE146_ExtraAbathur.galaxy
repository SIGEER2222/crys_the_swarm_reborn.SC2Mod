bool libE0EAE146_gf_XMTestBench_CatalogEntryPresent (int lp_player, string lp_scenarioKind, string lp_kind, int lp_catalog, string lp_entry, string lp_source) {
    if (lp_entry == "") {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "EXTRA_ABATHUR_CATALOG_MISSING", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_scenarioKind + " kind=" + lp_kind + " entry=blank source=" + lp_source);
        return false;
    }
    if (CatalogEntryIsValid(lp_catalog, lp_entry)) {
        libE0EAE146_gf_XMDbgLog("INFO", "EXTRA_ABATHUR_CATALOG_PRESENT", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_scenarioKind + " kind=" + lp_kind + " entry=" + lp_entry + " source=" + lp_source);
        return true;
    }
    libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
    libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
    libE0EAE146_gf_XMDbgLog("WARN", "EXTRA_ABATHUR_CATALOG_MISSING", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_scenarioKind + " kind=" + lp_kind + " entry=" + lp_entry + " source=" + lp_source + " reason=not_imported_to_XMFinal");
    return false;
}

