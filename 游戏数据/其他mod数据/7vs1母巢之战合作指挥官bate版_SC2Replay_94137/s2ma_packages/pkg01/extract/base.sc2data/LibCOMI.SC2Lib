    </Element>
    <Element Type="Comment" Id="3A3C44E1">
        <Comment>
            Objective of this trigger is to use the location of the caster and the location of the target to 
            interpolate the real target point of the Unleash Banshee ability.  It should be in a straight line 
            from the caster, through the target, all the way out to the edge of the map.  So we find out 
            length of the hypotenuse of triangle 1 and triangle 2 in the figure below, and fire the arrow to
            the shorter of the two triangle lengths.
        </Comment>
    </Element>
    <Element Type="Comment" Id="9908840D">
        <Comment>
                                                             /|
             _______________________/  |__
            |                                    |       /     |    |
            |                                    |  1 /  2   |    |
            |                                    |  /_____|    |
            |                                    T                 |
            |                                   /                   |
            |                                 /                     |
            |                               C                      |
            | ___________________________ |
        </Comment>
    </Element>
    <Element Type="FunctionCall" Id="2B96C5F0">
        <FunctionDef Type="FunctionDef" Library="Ntve" Id="C0083258"/>
        <FunctionCall Type="Comment" Library="COMI" Id="DA8C1984"/>
        <FunctionCall Type="Comment" Library="COMI" Id="53164BB0"/>
        <FunctionCall Type="FunctionCall" Library="COMI" Id="65BD448D"/>
        <FunctionCall Type="Comment" Library="COMI" Id="9A5F1A58"/>
        <FunctionCall Type="Comment" Library="COMI" Id="E5C1EAC8"/>
        <FunctionCall Type="FunctionCall" Library="COMI" Id="0A06A95D"/>
        <FunctionCall Type="Comment" Library="COMI" Id="8519186C"/>
        <FunctionCall Type="Comment" Library="COMI" Id="A2FB345F"/>
        <FunctionCall Type="FunctionCall" Library="COMI" Id="F4DEB165"/>
        <FunctionCall Type="Comment" Library="COMI" Id="F45A9C5C"/>
        <FunctionCall Type="Comment" Library="COMI" Id="80D24D61"/>
        <FunctionCall Type="FunctionCall" Library="COMI" Id="814EB9B2"/>
    </Element>
    <Element Type="Comment" Id="DA8C1984">
        <Comment>
            Quadrant I
        </Comment>
        <SubFunctionType Type="SubFuncType" Library="Ntve" Id="C7699CD9"/>
    </Element>
    <Element Type="Comment" Id="53164BB0">
        <Comment>
            Caster Bottom Left, Target Top Right
        </Comment>
