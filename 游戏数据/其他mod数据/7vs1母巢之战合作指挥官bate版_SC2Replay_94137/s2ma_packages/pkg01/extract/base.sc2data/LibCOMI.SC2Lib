    <Element Type="FunctionDef" Id="791FC617">
        <Identifier>CC_ForEachArmyCategory</Identifier>
        <Label Type="Label" Library="Ntve" Id="C5092BE2"/>
        <Internal/>
        <FlagAction/>
        <FlagSubFunctions/>
        <FlagAllowBreak/>
        <Parameter Type="ParamDef" Library="COMI" Id="DF98B07C"/>
        <SubFunctionType Type="SubFuncType" Library="COMI" Id="06E69CB4"/>
        <ScriptCode>
            #AUTOVAR(ae) = CatalogEntryCount(c_gameCatalogAbil);
            #AUTOVAR(ai) = 1;
            while (#AUTOVAR(ai) &lt;= #AUTOVAR(ae)) {
            #PARAM(indexAbility) = CatalogEntryGet(c_gameCatalogAbil, #AUTOVAR(ai));
            #AUTOVAR(ai) = #AUTOVAR(ai) + 1;
            #SUBFUNCS(actions)
            }
        </ScriptCode>
    </Element>
