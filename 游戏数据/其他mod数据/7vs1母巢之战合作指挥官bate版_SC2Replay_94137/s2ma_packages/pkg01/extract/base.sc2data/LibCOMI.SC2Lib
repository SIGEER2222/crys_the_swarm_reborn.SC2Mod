        <ScriptCode>
            AIAddAirDangerCampaignUnits(lp_player);
        </ScriptCode>
    </Element>
    <Element Type="Comment" Id="7C074A1C">
        <Comment>
            Pick a random Personality for the players based on the Tag the map selects
            Force both Players to use the same Commander Template, going for a more unified Enemy Front for which the Players must adapt
        </Comment>
