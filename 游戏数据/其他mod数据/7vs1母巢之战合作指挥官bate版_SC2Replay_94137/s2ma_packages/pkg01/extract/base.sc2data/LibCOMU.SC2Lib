    <Element Type="FunctionDef" Id="AA61EB76">
        <Internal/>
        <FlagAction/>
        <FlagSubFunctions/>
        <FlagAllowBreak/>
        <Parameter Type="ParamDef" Library="COMU" Id="7A81D61F"/>
        <SubFunctionType Type="SubFuncType" Library="COMU" Id="382A8900"/>
        <ScriptCode>
            #AUTOVAR(ai) = 1;
            #AUTOVAR(ae) = UserDataInstanceCount(&quot;Mutators&quot;)+1;
            while (#AUTOVAR(ai) &lt; #AUTOVAR(ae)) {
            #PARAM(indexMutator) = UserDataInstance(&quot;Mutators&quot;, #AUTOVAR(ai));
            #AUTOVAR(ai) = #AUTOVAR(ai)+1;
            #SUBFUNCS(actions)
            }
        </ScriptCode>
    </Element>
