    gt_AchSet = TriggerCreate("gt_AchSet_Func");
    TriggerAddEventDialogControl(gt_AchSet, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger: BonSet
//--------------------------------------------------------------------------------------------------
bool gt_BonSet_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;
    int lv_x;

    // Automatic Variable Declarations
    int autoE9F3B74C_val;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((DialogControlGetDialog(EventDialogControl()) == gv_achHolder))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    BankLoad("CampaignXCore", 1);
    lv_i = 0;
    for ( ; ( lv_i <= gv_bonN ) ; lv_i += 1 ) {
        autoE9F3B74C_val = EventDialogControl();
        if (autoE9F3B74C_val == gv_bon[lv_i].lv_btn[0]) {
            if ((gv_bon[lv_i].lv_val < 5)) {
                gv_achievementPoints += gv_bon[lv_i].lv_val;
                gv_bon[lv_i].lv_val = 0;
                libNtve_gf_SetDialogItemText(gv_bon[lv_i].lv_text, IntToText(gv_bon[lv_i].lv_val), PlayerGroupAll());
                BankValueSetFromInt(BankLastCreated(), gv_commander, IntToString(lv_i), gv_bon[lv_i].lv_val);
                BankSave(BankLastCreated());
                break;
            }
            else {
                gv_achievementPoints += 5;
                gv_bon[lv_i].lv_val -= 5;
                libNtve_gf_SetDialogItemText(gv_bon[lv_i].lv_text, IntToText(gv_bon[lv_i].lv_val), PlayerGroupAll());
                BankValueSetFromInt(BankLastCreated(), gv_commander, IntToString(lv_i), gv_bon[lv_i].lv_val);
                BankSave(BankLastCreated());
                break;
            }
        }
        else if (autoE9F3B74C_val == gv_bon[lv_i].lv_btn[1]) {
            if ((gv_bon[lv_i].lv_val > 0)) {
                gv_achievementPoints += 1;
                gv_bon[lv_i].lv_val -= 1;
                libNtve_gf_SetDialogItemText(gv_bon[lv_i].lv_text, IntToText(gv_bon[lv_i].lv_val), PlayerGroupAll());
                BankValueSetFromInt(BankLastCreated(), gv_commander, IntToString(lv_i), gv_bon[lv_i].lv_val);
                BankSave(BankLastCreated());
                break;
            }
            else {
                break;
            }
        }
        else if (autoE9F3B74C_val == gv_bon[lv_i].lv_btn[2]) {
            if ((gv_achievementPoints > 0) && (gv_bon[lv_i].lv_val < 30)) {
                gv_achievementPoints -= 1;
                gv_bon[lv_i].lv_val += 1;
                libNtve_gf_SetDialogItemText(gv_bon[lv_i].lv_text, IntToText(gv_bon[lv_i].lv_val), PlayerGroupAll());
                BankValueSetFromInt(BankLastCreated(), gv_commander, IntToString(lv_i), gv_bon[lv_i].lv_val);
                BankSave(BankLastCreated());
                break;
            }
            else {
                break;
            }
        }
        else if (autoE9F3B74C_val == gv_bon[lv_i].lv_btn[3]) {
            if ((gv_achievementPoints >= 5) && (gv_bon[lv_i].lv_val <= 25)) {
                gv_achievementPoints -= 5;
                gv_bon[lv_i].lv_val += 5;
                libNtve_gf_SetDialogItemText(gv_bon[lv_i].lv_text, IntToText(gv_bon[lv_i].lv_val), PlayerGroupAll());
                BankValueSetFromInt(BankLastCreated(), gv_commander, IntToString(lv_i), gv_bon[lv_i].lv_val);
                BankSave(BankLastCreated());
                break;
            }
            else {
                if ((gv_achievementPoints == 0)) {
                    break;
                }
                else {
                    lv_x = gv_bon[lv_i].lv_val;
                    lv_x += gv_achievementPoints;
                    if ((lv_x > 30)) {
                        gv_bon[lv_i].lv_val = 30;
                        gv_achievementPoints = (lv_x-30);
                        libNtve_gf_SetDialogItemText(gv_bon[lv_i].lv_text, IntToText(gv_bon[lv_i].lv_val), PlayerGroupAll());
                        BankValueSetFromInt(BankLastCreated(), gv_commander, IntToString(lv_i), gv_bon[lv_i].lv_val);
                        BankSave(BankLastCreated());
                        break;
                    }
                    else {
                        gv_bon[lv_i].lv_val = lv_x;
                        gv_achievementPoints = 0;
                        libNtve_gf_SetDialogItemText(gv_bon[lv_i].lv_text, IntToText(gv_bon[lv_i].lv_val), PlayerGroupAll());
                        BankValueSetFromInt(BankLastCreated(), gv_commander, IntToString(lv_i), gv_bon[lv_i].lv_val);
                        BankSave(BankLastCreated());
                        break;
                    }
                }
            }
        }
        else {
        }
    }
    return true;
}

