bool gt_LevelNext_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    const int auto960BEADA_ae = gv_maps;
    const int auto960BEADA_ai = 1;

    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((DialogControlGetDialog(EventDialogControl()) == gv_levelHolder))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_i = 1;
    for ( ; ( (auto960BEADA_ai >= 0 && lv_i <= auto960BEADA_ae) || (auto960BEADA_ai < 0 && lv_i >= auto960BEADA_ae) ) ; lv_i += auto960BEADA_ai ) {
        if ((EventDialogControl() == gv_mapButtons[lv_i])) {
            TriggerExecute(gt_SaveBank, true, true);
            GameOver(1, c_gameOverVictory, false, false);
            GameSetNextMap((("XM/") + UserDataGetString("Campaign", "Wol", "MapPathName", lv_i)));
            break;
        }

    }
    return true;
}

