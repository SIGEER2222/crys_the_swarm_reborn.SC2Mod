//--------------------------------------------------------------------------------------------------
bool gt_DifficultySet_Func (bool testConds, bool runActions) {
    int init_i;

    // Variable Declarations
    int[4] lv_dif;
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization
    for (init_i = 0; init_i <= 3; init_i += 1) {
        lv_dif[init_i] = 4;
    }

    // Conditions
    if (testConds) {
        if (!((DialogControlGetDialog(EventDialogControl()) == gv_difficultyHolder))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_dif[0] = 1;
    lv_dif[1] = 2;
    lv_dif[2] = 3;
    lv_dif[3] = 4;
    lv_i = 0;
    for ( ; ( lv_i <= 3 ) ; lv_i += 1 ) {
        if ((EventDialogControl() == gv_difficulty[lv_i])) {
            libNtve_gf_SetDialogItemDesaturated(gv_difficulty[lv_i], true, PlayerGroupAll());
            SetNextMissionDifficulty(PlayerGroupSingle(EventPlayer()), lv_dif[lv_i]);
        }
        else {
            libNtve_gf_SetDialogItemDesaturated(gv_difficulty[lv_i], false, PlayerGroupAll());
        }
    }
    return true;
}

