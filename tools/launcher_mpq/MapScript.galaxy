        libNtve_gf_DisplayScreenImage(1, "Assets\\Textures\\ui_glues_scorescreen_racebg_terr.dds", c_triggerBlendModeAdd, 2120, 1200, c_anchorCenter, 0, 0);
    }
    SetNextMissionDifficulty(PlayerGroupAll(), 4);
    TriggerExecute(gt_LevelUI, true, true);
    TriggerExecute(gt_AchUI, true, false);
    TriggerExecute(gt_DifficultyUI, true, false);
    TriggerExecute(gt_CommanderUI, true, false);
    TriggerExecute(gt_CleanBankUI, true, false);
    return true;
}

