//--------------------------------------------------------------------------------------------------
// Trigger: AchSet
//--------------------------------------------------------------------------------------------------
bool gt_AchSet_Func (bool testConds, bool runActions) {
    // Variable Declarations
    int lv_i;

    // Automatic Variable Declarations
    // Variable Initialization

    // Conditions
    if (testConds) {
        if (!((DialogControlGetDialog(EventDialogControl()) == gv_achHolder))) {
            return false;
        }
    }

    // Actions
    if (!runActions) {
        return true;
    }

    lv_i = 0;
    for ( ; ( lv_i <= gv_achN ) ; lv_i += 1 ) {
        if ((EventDialogControl() == gv_ach[lv_i].lv_btn)) {
            if ((lib67C0F0E7_gf_BitMaskTrueIndexIs(gv_achBitMask, lv_i) == true)) {
                gv_achBitMask = lib67C0F0E7_gf_BitMaskSetIndex(gv_achBitMask, lv_i, false);
                gv_achievementPoints += gv_ach[lv_i].lv_cost;
                libNtve_gf_SetDialogItemDesaturated(gv_ach[lv_i].lv_btn, false, PlayerGroupAll());
                BankLoad("CampaignXCore", 1);
                BankValueSetFromInt(BankLastCreated(), gv_commander, "AchBit", gv_achBitMask);
                BankSave(BankLastCreated());
                break;
            }
            else {
                if ((gv_achievementPoints >= gv_ach[lv_i].lv_cost)) {
                    gv_achBitMask = lib67C0F0E7_gf_BitMaskSetIndex(gv_achBitMask, lv_i, true);
                    gv_achievementPoints -= gv_ach[lv_i].lv_cost;
                    libNtve_gf_SetDialogItemDesaturated(gv_ach[lv_i].lv_btn, true, PlayerGroupAll());
                    BankLoad("CampaignXCore", 1);
                    BankValueSetFromInt(BankLastCreated(), gv_commander, "AchBit", gv_achBitMask);
                    BankSave(BankLastCreated());
                    break;
                }

            }
        }

    }
    return true;
}

