    UISetWorldVisible(PlayerGroupAll(), false);
    AITimePause(true);
    CameraLockInput(1, true);
    auto108709B1_val = PlayerRace(1);
    if (auto108709B1_val == "Terr") {
        libNtve_gf_DisplayScreenImage(1, "Assets\\Textures\\ui_glues_scorescreen_racebg_terr.dds", c_triggerBlendModeAdd, 2120, 1200, c_anchorCenter, 0, 0);
    }
    else if (auto108709B1_val == "Prot") {
        libNtve_gf_DisplayScreenImage(1, "Assets\\Textures\\ui_glues_scorescreen_racebg_prot.dds", c_triggerBlendModeAdd, 2120, 1200, c_anchorCenter, 0, 0);
    }
    else if (auto108709B1_val == "Zerg") {
        libNtve_gf_DisplayScreenImage(1, "Assets\\Textures\\ui_glues_scorescreen_racebg_zerg.dds", c_triggerBlendModeAdd, 2120, 1200, c_anchorCenter, 0, 0);
    }
