//--------------------------------------------------------------------------------------------------
// Global Functions
//--------------------------------------------------------------------------------------------------
string gf_XMTB_GetCommanderByIndex (int lp_index) {
    if (lp_index == 1) { return "Raynor"; }
    if (lp_index == 2) { return "Kerrigan"; }
    if (lp_index == 3) { return "Artanis"; }
    if (lp_index == 4) { return "Swann"; }
    if (lp_index == 5) { return "Zagara"; }
    if (lp_index == 6) { return "Vorazun"; }
    if (lp_index == 7) { return "Karax"; }
    if (lp_index == 8) { return "Abathur"; }
    if (lp_index == 9) { return "Alarak"; }
    if (lp_index == 10) { return "Nova"; }
    if (lp_index == 11) { return "Stukov"; }
    if (lp_index == 12) { return "Fenix"; }
    if (lp_index == 13) { return "Dehaka"; }
    if (lp_index == 14) { return "Horner"; }
    if (lp_index == 15) { return "Tychus"; }
    if (lp_index == 16) { return "Zeratul"; }
    if (lp_index == 17) { return "Stetmann"; }
    if (lp_index == 18) { return "Mengsk"; }
    if (lp_index == 19) { return "AbathurCustom"; }
    return "Raynor";
}

text gf_XMTB_GetCommanderTextByIndex (int lp_index) {
    return StringToText(gf_XMTB_GetCommanderByIndex(lp_index));
}

string gf_XMTB_GetScenarioByIndex (int lp_index) {
    if (lp_index == 1) { return "standard_base"; }
    if (lp_index == 2) { return "power_fusion"; }
    if (lp_index == 3) { return "panel_cost_smoke"; }
    if (lp_index == 4) { return "panel_effect_smoke"; }
    if (lp_index == 5) { return "full_buildings"; }
    if (lp_index == 6) { return "full_units"; }
    if (lp_index == 7) { return "initial_units"; }
    if (lp_index == 8) { return "level15_units"; }
    if (lp_index == 9) { return "fusion_final_units"; }
    if (lp_index == 10) { return "hero_modes"; }
    if (lp_index == 11) { return "unit_ability_smoke"; }
    if (lp_index == 12) { return "unit_evolution_smoke"; }
    if (lp_index == 13) { return "tech_smoke"; }
    if (lp_index == 14) { return "cargo_light"; }
    if (lp_index == 15) { return "cargo_heavy"; }
    if (lp_index == 16) { return "cargo_air"; }
    if (lp_index == 17) { return "special_smoke"; }
    if (lp_index == 18) { return "personal_smoke"; }
    if (lp_index == 19) { return "extra_abathur_init"; }
    if (lp_index == 20) { return "extra_abathur_zergling_to_pygalisk"; }
    if (lp_index == 21) { return "extra_abathur_purchase"; }
    if (lp_index == 22) { return "extra_abathur_crawler"; }
    return "standard_base";
}

text gf_XMTB_GetScenarioTextByIndex (int lp_index) {
    return StringToText(gf_XMTB_GetScenarioByIndex(lp_index));
}

void gf_XMTB_Log (string lp_level, string lp_event, string lp_message) {
    TriggerDebugOutput(1, StringToText("[XM_DBG][" + lp_level + "][" + lp_event + "] " + lp_message), false);
    gv_xmTbLastEvent = lp_event;
}

void gf_XMTB_UpdateSummary () {
    string lv_text;

    lv_text = XMTestBench_GetSummaryText(1);
    lv_text = lv_text + " | Map: CommanderTestBench";
    lv_text = lv_text + " | Trigger: button/chat -> XMTestBench_*";
    lv_text = lv_text + " | Panel: command invoke, not mouse simulation.";
    lv_text = lv_text + " | MapWarnings: " + IntToString(gv_xmTbWarnings);
    lv_text = lv_text + " | MapErrors: " + IntToString(gv_xmTbErrors);
    lv_text = lv_text + " | MapLast: " + gv_xmTbLastEvent;

    libNtve_gf_SetDialogItemText(gv_xmTbSummaryLabel, StringToText(lv_text), PlayerGroupAll());
}

void gf_XMTB_Clear () {
    XMTestBench_Clear(1);
    gv_xmTbCreated = 0;
    gv_xmTbMissing = 0;
    gv_xmTbWarnings = XMTestBench_GetWarningCount(1);
    gv_xmTbErrors = XMTestBench_GetErrorCount(1);
    gv_xmTbLastEvent = "TEST_CLEAR";
    gf_XMTB_UpdateSummary();
}

void gf_XMTB_SetCommander (string lp_commander) {
    gv_xmTbCurrentCommander = lp_commander;
    XMTestBench_SetCommander(1, lp_commander);
    gv_xmTbWarnings = XMTestBench_GetWarningCount(1);
    gv_xmTbErrors = XMTestBench_GetErrorCount(1);
    gv_xmTbLastEvent = "TEST_COMMANDER_SET";
    gf_XMTB_UpdateSummary();
}

void gf_XMTB_ChatSelectCommander (int lp_index, string lp_commander) {
    gv_xmTbCurrentCommanderIndex = lp_index;
    gf_XMTB_Clear();
    gf_XMTB_SetCommander(lp_commander);
}

void gf_XMTB_RunScenario (string lp_scenario) {
    gv_xmTbCurrentScenario = lp_scenario;
    XMTestBench_RunScenario(1, lp_scenario);
    gv_xmTbWarnings = XMTestBench_GetWarningCount(1);
    gv_xmTbErrors = XMTestBench_GetErrorCount(1);
    gv_xmTbLastEvent = "TEST_SCENARIO_DONE";
    gf_XMTB_UpdateSummary();
}

void gf_XMTB_RunCurrentScenario () {
    gf_XMTB_Clear();
    gf_XMTB_SetCommander(gv_xmTbCurrentCommander);
    gf_XMTB_RunScenario(gv_xmTbCurrentScenario);
}

void gf_XMTB_RunAllSmoke () {
    int lv_totalWarnings;
    int lv_totalErrors;
    string lv_result;

    lv_totalWarnings = 0;
    lv_totalErrors = 0;

    gf_XMTB_Log("INFO", "TEST_RUN_ALL_START", "mode=runtime_api scenarios=power_fusion,standard_base,panel_cost_smoke,full_buildings,full_units");

    gf_XMTB_Clear();
    gf_XMTB_SetCommander(gv_xmTbCurrentCommander);
    gf_XMTB_RunScenario("power_fusion");
    lv_totalWarnings += XMTestBench_GetWarningCount(1);
    lv_totalErrors += XMTestBench_GetErrorCount(1);
    gf_XMTB_Log("INFO", "TEST_RUN_ALL_STEP", "scenario=power_fusion warnings=" + IntToString(XMTestBench_GetWarningCount(1)) + " errors=" + IntToString(XMTestBench_GetErrorCount(1)));

    gf_XMTB_Clear();
    gf_XMTB_SetCommander(gv_xmTbCurrentCommander);
    gf_XMTB_RunScenario("standard_base");
    lv_totalWarnings += XMTestBench_GetWarningCount(1);
    lv_totalErrors += XMTestBench_GetErrorCount(1);
    gf_XMTB_Log("INFO", "TEST_RUN_ALL_STEP", "scenario=standard_base warnings=" + IntToString(XMTestBench_GetWarningCount(1)) + " errors=" + IntToString(XMTestBench_GetErrorCount(1)));

    gf_XMTB_Clear();
    gf_XMTB_SetCommander(gv_xmTbCurrentCommander);
    gf_XMTB_RunScenario("panel_cost_smoke");
    lv_totalWarnings += XMTestBench_GetWarningCount(1);
    lv_totalErrors += XMTestBench_GetErrorCount(1);
    gf_XMTB_Log("INFO", "TEST_RUN_ALL_STEP", "scenario=panel_cost_smoke warnings=" + IntToString(XMTestBench_GetWarningCount(1)) + " errors=" + IntToString(XMTestBench_GetErrorCount(1)));

    gf_XMTB_Clear();
    gf_XMTB_SetCommander(gv_xmTbCurrentCommander);
    gf_XMTB_RunScenario("full_buildings");
    lv_totalWarnings += XMTestBench_GetWarningCount(1);
    lv_totalErrors += XMTestBench_GetErrorCount(1);
    gf_XMTB_Log("INFO", "TEST_RUN_ALL_STEP", "scenario=full_buildings warnings=" + IntToString(XMTestBench_GetWarningCount(1)) + " errors=" + IntToString(XMTestBench_GetErrorCount(1)));

    gf_XMTB_Clear();
    gf_XMTB_SetCommander(gv_xmTbCurrentCommander);
    gf_XMTB_RunScenario("full_units");
    lv_totalWarnings += XMTestBench_GetWarningCount(1);
    lv_totalErrors += XMTestBench_GetErrorCount(1);
    gf_XMTB_Log("INFO", "TEST_RUN_ALL_STEP", "scenario=full_units warnings=" + IntToString(XMTestBench_GetWarningCount(1)) + " errors=" + IntToString(XMTestBench_GetErrorCount(1)));

    if (lv_totalErrors > 0) {
        lv_result = "error";
    }
    else if (lv_totalWarnings > 0) {
        lv_result = "warning";
    }
    else {
        lv_result = "ok";
    }

    gv_xmTbWarnings = lv_totalWarnings;
    gv_xmTbErrors = lv_totalErrors;
    gv_xmTbLastEvent = "TEST_RUN_ALL_DONE";
    gf_XMTB_Log("INFO", "TEST_RUN_ALL_DONE", "mode=runtime_api result=" + lv_result + " totalWarnings=" + IntToString(lv_totalWarnings) + " totalErrors=" + IntToString(lv_totalErrors));
    gf_XMTB_UpdateSummary();
}

void gf_XMTB_BuildCommanderUI () {
    int lv_i;
    int lv_x;
    int lv_y;

    DialogCreate(1540, 150, c_anchorTopLeft, 40, 20, true);
    gv_xmTbCommanderDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbCommanderDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbCommanderDialog, false);

    lv_i = 1;
    lv_x = 0;
    lv_y = 0;
    for (; lv_i <= gv_xmTbCommanderNum; lv_i += 1) {
        libNtve_gf_CreateDialogItemButton(gv_xmTbCommanderDialog, 120, 38, c_anchorTopLeft, lv_x, lv_y, StringToText("Set commander"), gf_XMTB_GetCommanderTextByIndex(lv_i), "");
        gv_xmTbCommanderButton[lv_i] = DialogControlLastCreated();
        lv_x += 126;
        if (lv_x >= 756) {
            lv_x = 0;
            lv_y += 44;
        }
    }
}

void gf_XMTB_BuildScenarioUI () {
    int lv_i;
    int lv_x;
    int lv_y;

    DialogCreate(330, 440, c_anchorLeft, 30, 150, true);
    gv_xmTbScenarioDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbScenarioDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbScenarioDialog, false);

    lv_i = 1;
    lv_x = 0;
    lv_y = 0;
    for (; lv_i <= gv_xmTbScenarioNum; lv_i += 1) {
        libNtve_gf_CreateDialogItemButton(gv_xmTbScenarioDialog, 150, 34, c_anchorTopLeft, lv_x, lv_y, StringToText("Run scenario"), gf_XMTB_GetScenarioTextByIndex(lv_i), "");
        gv_xmTbScenarioButton[lv_i] = DialogControlLastCreated();
        if (lv_x == 0) {
            lv_x = 158;
        }
        else {
            lv_x = 0;
            lv_y += 40;
        }
    }
}

void gf_XMTB_BuildSummaryUI () {
    DialogCreate(430, 360, c_anchorRight, 30, 150, true);
    gv_xmTbSummaryDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbSummaryDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbSummaryDialog, false);

    libNtve_gf_CreateDialogItemLabel(gv_xmTbSummaryDialog, 400, 330, c_anchorTopLeft, 15, 15, StringToText("CommanderTestBench starting..."), ColorWithAlpha(0,0,0,0), false, 2.0);
    gv_xmTbSummaryLabel = DialogControlLastCreated();
    libNtve_gf_SetDialogItemStyle(gv_xmTbSummaryLabel, "ModCenterSize24", PlayerGroupAll());
}

void gf_XMTB_BuildActionUI () {
    DialogCreate(760, 56, c_anchorTopLeft, 420, 690, true);
    gv_xmTbActionDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbActionDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbActionDialog, false);

    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 130, 38, c_anchorLeft, 0, 0, StringToText("Clear runtime test state"), StringToText("Clear"), "");
    gv_xmTbButtonClear = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 130, 38, c_anchorLeft, 140, 0, StringToText("Rerun current scenario"), StringToText("Rerun"), "");
    gv_xmTbButtonRerun = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 160, 38, c_anchorLeft, 280, 0, StringToText("Next commander"), StringToText("Next Commander"), "");
    gv_xmTbButtonNextCommander = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 160, 38, c_anchorLeft, 450, 0, StringToText("Run current commander smoke set"), StringToText("Run Smoke"), "");
    gv_xmTbButtonRunAll = DialogControlLastCreated();
}

void gf_XMTB_BuildUI () {
    gf_XMTB_BuildCommanderUI();
    gf_XMTB_BuildScenarioUI();
    gf_XMTB_BuildSummaryUI();
    gf_XMTB_BuildActionUI();
}

//--------------------------------------------------------------------------------------------------
// Triggers
//--------------------------------------------------------------------------------------------------
bool gt_XMTB_Init_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    gv_xmTbCommanderDialog = c_invalidDialogId;
    gv_xmTbScenarioDialog = c_invalidDialogId;
    gv_xmTbSummaryDialog = c_invalidDialogId;
    gv_xmTbActionDialog = c_invalidDialogId;
    gv_xmTbCurrentCommander = "Raynor";
    gv_xmTbCurrentCommanderIndex = 1;
    gv_xmTbCurrentScenario = "standard_base";
    gv_xmTbLastEvent = "INIT";
    gv_xmTbWarnings = 0;
    gv_xmTbErrors = 0;
    gv_xmTbCreated = 0;
    gv_xmTbMissing = 0;

    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(1, c_playerPropSuppliesMade, c_playerPropOperSetTo, 200);
    PlayerSetState(1, c_playerStateMineralCostIgnored, false);
    PlayerSetState(1, c_playerStateVespeneCostIgnored, false);
    PlayerSetState(1, c_playerStateFoodIgnored, true);

    gf_XMTB_BuildUI();
    gf_XMTB_Log("INFO", "TESTBENCH_INIT", "map=CommanderTestBench mode=runtime_api");
    XMTestBench_SetCommander(1, gv_xmTbCurrentCommander);
    gf_XMTB_UpdateSummary();
    return true;
}

bool gt_XMTB_CommanderClick_Func (bool testConds, bool runActions) {
    int lv_i;

    if (!runActions) {
        return true;
    }
    if (DialogControlGetDialog(EventDialogControl()) != gv_xmTbCommanderDialog) {
        return true;
    }

    lv_i = 1;
    for (; lv_i <= gv_xmTbCommanderNum; lv_i += 1) {
        if (EventDialogControl() == gv_xmTbCommanderButton[lv_i]) {
            gv_xmTbCurrentCommanderIndex = lv_i;
            gf_XMTB_Clear();
            gf_XMTB_SetCommander(gf_XMTB_GetCommanderByIndex(lv_i));
            return true;
        }
    }
    return true;
}

bool gt_XMTB_ScenarioClick_Func (bool testConds, bool runActions) {
    int lv_i;

    if (!runActions) {
        return true;
    }
    if (DialogControlGetDialog(EventDialogControl()) != gv_xmTbScenarioDialog) {
        return true;
    }

    lv_i = 1;
    for (; lv_i <= gv_xmTbScenarioNum; lv_i += 1) {
        if (EventDialogControl() == gv_xmTbScenarioButton[lv_i]) {
            gv_xmTbCurrentScenario = gf_XMTB_GetScenarioByIndex(lv_i);
            gf_XMTB_RunCurrentScenario();
            return true;
        }
    }
    return true;
}

bool gt_XMTB_ActionClick_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (DialogControlGetDialog(EventDialogControl()) != gv_xmTbActionDialog) {
        return true;
    }

    if (EventDialogControl() == gv_xmTbButtonClear) {
        gf_XMTB_Clear();
    }
    else if (EventDialogControl() == gv_xmTbButtonRerun) {
        gf_XMTB_RunCurrentScenario();
    }
    else if (EventDialogControl() == gv_xmTbButtonNextCommander) {
        gv_xmTbCurrentCommanderIndex += 1;
        if (gv_xmTbCurrentCommanderIndex > gv_xmTbCommanderNum) {
            gv_xmTbCurrentCommanderIndex = 1;
        }
        gf_XMTB_Clear();
        gf_XMTB_SetCommander(gf_XMTB_GetCommanderByIndex(gv_xmTbCurrentCommanderIndex));
        gf_XMTB_RunScenario(gv_xmTbCurrentScenario);
    }
    else if (EventDialogControl() == gv_xmTbButtonRunAll) {
        gf_XMTB_RunAllSmoke();
    }
    return true;
}

