// XMFinal split module: CommanderTestBench core utilities.

string libE0EAE146_gf_NormalizeCommanderId (string lp_commander) {
    if (lp_commander == "") {
        return "Raynor";
    }
    if ((lp_commander == "Horner") || (lp_commander == "HanHorner") || (lp_commander == "HanAndHorner")) {
        return "Mira";
    }
    if ((lp_commander == "CustomAbathur") || (lp_commander == "AbathurCustom")) {
        return "AbathurCustom";
    }
    return lp_commander;
}

void libE0EAE146_gf_XMDbgLog (string lp_level, string lp_event, string lp_message) {
    TriggerDebugOutput(1, StringToText("[XM_DBG][" + lp_level + "][" + lp_event + "] " + lp_message), false);
}

bool libE0EAE146_gf_XMTestBench_PlayerValid (int lp_player) {
    if ((lp_player < 1) || (lp_player > libE0EAE146_gv_xmTestBenchMaxPlayers)) {
        return false;
    }
    return true;
}

void libE0EAE146_gf_XMTestBench_ResetCounters (int lp_player) {
    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }
    libE0EAE146_gv_xmTestBenchCreated[lp_player] = 0;
    libE0EAE146_gv_xmTestBenchMissing[lp_player] = 0;
    libE0EAE146_gv_xmTestBenchWarnings[lp_player] = 0;
    libE0EAE146_gv_xmTestBenchErrors[lp_player] = 0;
    libE0EAE146_gv_xmTestBenchMissingIds[lp_player] = "";
    libE0EAE146_gv_xmTestBenchUnits[lp_player] = UnitGroupEmpty();
}

void libE0EAE146_gf_XMTestBench_SetLastEvent (int lp_player, string lp_event) {
    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }
    libE0EAE146_gv_xmTestBenchLastEvent[lp_player] = lp_event;
}

void libE0EAE146_gf_XMTestBench_AddWarning (int lp_player) {
    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }
    libE0EAE146_gv_xmTestBenchWarnings[lp_player] += 1;
}

void libE0EAE146_gf_XMTestBench_AddError (int lp_player) {
    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }
    libE0EAE146_gv_xmTestBenchErrors[lp_player] += 1;
}

int libE0EAE146_gf_XMTestBench_CountPlayerUnits (int lp_player) {
    unitgroup lv_units;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return 0;
    }
    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    return UnitGroupCount(lv_units, c_unitCountAlive);
}

void libE0EAE146_gf_XMTestBench_RemovePlayerUnits (int lp_player) {
    unit lv_unit;
    unitgroup lv_units;
    int lv_count;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }

    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_units, c_unitCountAll);
    for (;; lv_count -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lv_units, lv_count);
        if (lv_unit == null) { break; }
        UnitRemove(lv_unit);
    }
}

void libE0EAE146_gf_XMTestBench_SeedCommanderBank (int lp_player, string lp_commander) {
    string lv_normalized;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }

    lv_normalized = libE0EAE146_gf_NormalizeCommanderId(lp_commander);
    libE0EAE146_gv_xmRuntimeCommanderOverrideEnabled = true;
    libE0EAE146_gv_xmRuntimeCommanderOverride = lv_normalized;
    libE0EAE146_gv_commander = lv_normalized;
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_COMMANDER_OVERRIDE", "player=" + IntToString(lp_player) + " commander=" + lv_normalized + " achBit=255 mastery=30 bank=not_saved");
}

void libE0EAE146_gf_XMTestBench_LogScenarioStub (int lp_player, string lp_scenarioKind, string lp_reason) {
    libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_SCENARIO_STUB");
    libE0EAE146_gf_XMDbgLog("WARN", "TEST_SCENARIO_STUB", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_scenarioKind + " reason=" + lp_reason);
}

void libE0EAE146_gf_XMTestBench_LogScenarioSkip (int lp_player, string lp_scenarioKind, string lp_reason) {
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "TEST_SCENARIO_SKIPPED");
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_SCENARIO_SKIPPED", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_scenarioKind + " reason=" + lp_reason);
}

void libE0EAE146_gf_XMTestBench_RecordMissingObject (int lp_player, string lp_objectId) {
    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }
    if (libE0EAE146_gv_xmTestBenchMissingIds[lp_player] == "") {
        libE0EAE146_gv_xmTestBenchMissingIds[lp_player] = lp_objectId;
        return;
    }
    libE0EAE146_gv_xmTestBenchMissingIds[lp_player] = libE0EAE146_gv_xmTestBenchMissingIds[lp_player] + "," + lp_objectId;
}

point libE0EAE146_gf_XMTestBench_SpawnPoint (int lp_player, int lp_index, fixed lp_radius, fixed lp_spacing) {
    int lv_slotsPerRow;
    int lv_row;
    int lv_col;
    point lv_origin;

    lv_slotsPerRow = 5;
    lv_row = 0;
    lv_col = (lp_index - 1);
    lv_origin = PointWithOffsetPolar(PlayerStartLocation(lp_player), lp_radius, 0.0);
    while (lv_col >= lv_slotsPerRow) {
        lv_col -= lv_slotsPerRow;
        lv_row += 1;
    }
    return PointWithOffsetPolar(PointWithOffsetPolar(lv_origin, (IntToFixed(lv_col) * lp_spacing), 0.0), (IntToFixed(lv_row) * lp_spacing), 270.0);
}

void libE0EAE146_gf_XMTestBench_CreateProfileUnit (int lp_player, string lp_unitType, point lp_point, string lp_rosterKind) {
    int lv_before;
    int lv_after;
    int lv_created;
    unitgroup lv_createdGroup;

    if (lp_unitType == "") {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_RecordMissingObject(lp_player, "blank");
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "TEST_PROFILE_OBJECT_MISSING", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=blank");
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType)) {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_RecordMissingObject(lp_player, lp_unitType);
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "TEST_PROFILE_OBJECT_INVALID", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=" + lp_unitType + " reason=missing_catalog_entry");
        return;
    }

    lv_before = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, lp_unitType, c_unitCreateIgnorePlacement, lp_player, lp_point);
    lv_after = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    lv_createdGroup = UnitLastCreatedGroup();
    lv_created = UnitGroupCount(lv_createdGroup, c_unitCountAll);
    if ((lv_created <= 0) && (lv_after > lv_before)) {
        lv_created = MaxI(0, (lv_after - lv_before));
    }
    if (lv_created > 0) {
        libE0EAE146_gv_xmTestBenchCreated[lp_player] += lv_created;
        UnitGroupAddUnitGroup(libE0EAE146_gv_xmTestBenchUnits[lp_player], lv_createdGroup);
        libE0EAE146_gf_XMDbgLog("INFO", "TEST_PROFILE_OBJECT_CREATED", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=" + lp_unitType + " count=" + IntToString(lv_created));
    }
    else {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_RecordMissingObject(lp_player, lp_unitType);
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "TEST_PROFILE_OBJECT_NOT_CREATED", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=" + lp_unitType + " reason=create_returned_no_count_delta");
    }
}
