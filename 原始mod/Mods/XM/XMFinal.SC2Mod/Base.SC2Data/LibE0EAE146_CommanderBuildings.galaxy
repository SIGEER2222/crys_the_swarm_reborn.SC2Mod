bool libE0EAE146_gf_XMTestBench_RunCommanderBuildings (int lp_player, string lp_commander, string lp_rosterKind) {
    if ((lp_commander == "Abathur") && libE0EAE146_gf_XMTestBench_AbathurBuildings(lp_player, lp_rosterKind)) {
        return true;
    }
    if ((lp_commander == "Alarak") && libE0EAE146_gf_XMTestBench_AlarakBuildings(lp_player, lp_rosterKind)) {
