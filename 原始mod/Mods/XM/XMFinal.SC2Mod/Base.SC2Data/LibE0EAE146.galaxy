    }
    else if (lp_scenarioKind == "power_fusion") {
        libE0EAE146_gf_XMTestBench_RunPowerFusion(lp_player);
    }
    else if (lp_scenarioKind == "panel_cost_smoke") {
        libE0EAE146_gf_XMTestBench_RunPanelCostSmoke(lp_player);
    }
    else if (lp_scenarioKind == "panel_effect_smoke") {
        libE0EAE146_gf_XMTestBench_RunPanelEffectSmoke(lp_player);
    }
    else if ((lp_scenarioKind == "full_buildings") || (lp_scenarioKind == "full_units") || (lp_scenarioKind == "initial_units") || (lp_scenarioKind == "level15_units") || (lp_scenarioKind == "fusion_final_units")) {
        libE0EAE146_gf_XMTestBench_RunRoster(lp_player, lp_scenarioKind);
