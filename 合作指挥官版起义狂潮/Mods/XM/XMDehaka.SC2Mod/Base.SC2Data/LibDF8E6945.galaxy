        if (auto8B4DF474_var == null) { break; }
        if ((auto8B4DF474_var != UnitLastCreated()) && (UnitGetCustomValue(auto8B4DF474_var, 63) != 0.0)) {
            lib67C0F0E7_gf_UnitAddCustomValue(auto8B4DF474_var, 63, lv_essence);
            UnitCreateEffectUnit(UnitLastCreated(), "EssenceLMDehaka", auto8B4DF474_var);
            return true;
        }

    }
    UnitSetCustomValue(UnitLastCreated(), 63, lv_essence);
    return true;
}

