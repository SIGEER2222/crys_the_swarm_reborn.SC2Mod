}

void libDF8E6945_gf_DehakaBroodbrother () {
    // Automatic Variable Declarations
    // Implementation
    TechTreeUpgradeAddLevel(libDF8E6945_gv_dehakaPlayer, "CommanderPrestigeDehakaClone", 1);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "DehakaCoopClone", 0, libDF8E6945_gv_dehakaPlayer, UnitGetPosition(libDF8E6945_gv_dehaka));
    UnitCreateEffectUnit(libDF8E6945_gv_dehaka, "CommanderPrestigeDehakaCloneSpawnTracker", UnitLastCreated());
