// Trigger: DehakaRevive
//--------------------------------------------------------------------------------------------------
bool libDF8E6945_gt_DehakaRevive_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_i;
    int lv_level;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_i = UnitBehaviorDuration(EventPlayerEffectUsedUnit(c_effectUnitCaster), "AutoReviveDehaka");
    lv_level = UnitXPGetCurrentLevel(libDF8E6945_gv_dehaka, "DehakaVeterancyCoopFinal");

    // Actions
    if (!runActions) {
        return true;
    }

    lv_i += lv_level;
    lv_i -= 24.0;
    UnitBehaviorSetDurationRemaining(EventPlayerEffectUsedUnit(c_effectUnitCaster), "AutoReviveDehaka", lv_i);
    return true;
}

