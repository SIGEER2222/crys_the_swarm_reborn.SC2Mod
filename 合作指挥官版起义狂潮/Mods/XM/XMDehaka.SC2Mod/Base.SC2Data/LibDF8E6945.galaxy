void libDF8E6945_gf_DehakaRefreshLevelState (unit lp_dehaka) {
    // Variable Declarations
    int lv_level;
    fixed lv_scale;
    fixed lv_turnRate;
    string lv_unitType;

    // Implementation
    if ((lp_dehaka == null)) {
        return;
    }
    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(lp_dehaka, null);
    lv_unitType = UnitGetType(lp_dehaka);
    lv_scale = (IntToFixed(lv_level) * 0.1) + 0.5;
    libNtve_gf_SendActorMessageToUnit(lp_dehaka, libNtve_gf_SetScale(lv_scale, lv_scale, lv_scale, 0.0));
    libNtve_gf_CatalogFieldValueSetAsReal(c_gameCatalogUnit, lv_unitType, "Radius", libDF8E6945_gv_dehakaPlayer, (IntToFixed(lv_level) * 0.0625) + 0.5);
    lv_turnRate = 800.0 - (IntToFixed(lv_level) * 40.0);
    if ((lv_turnRate < 300.0)) {
        lv_turnRate = 300.0;
    }
    libNtve_gf_CatalogFieldValueSetAsReal(c_gameCatalogUnit, lv_unitType, "TurningRate", libDF8E6945_gv_dehakaPlayer, lv_turnRate);
    libNtve_gf_CatalogFieldValueSetAsReal(c_gameCatalogUnit, lv_unitType, "StationaryTurningRate", libDF8E6945_gv_dehakaPlayer, lv_turnRate);
    libNtve_gf_CatalogFieldValueSetAsReal(c_gameCatalogEffect, "DehakaDroneReviveTimerRefLink", "Amount", libDF8E6945_gv_dehakaPlayer, IntToFixed(lv_level) - 24.0);
    if (((lv_level >= 6) && (TechTreeUpgradeCount(libDF8E6945_gv_dehakaPlayer, "DehakaCoopStage2", c_techCountCompleteOnly) == 0))) {
        TechTreeUpgradeAddLevel(libDF8E6945_gv_dehakaPlayer, "DehakaCoopStage2", 1);
        if ((UnitBehaviorCount(lp_dehaka, "DehakaMassive") == 0)) {
            UnitBehaviorAdd(lp_dehaka, "DehakaMassive", lp_dehaka, 1);
        }
        if ((UnitBehaviorCount(lp_dehaka, "DehakaModelSwapStun") == 0)) {
            UnitBehaviorAdd(lp_dehaka, "DehakaModelSwapStun", lp_dehaka, 1);
        }
    }
    if (((lv_level >= 10) && (TechTreeUpgradeCount(libDF8E6945_gv_dehakaPlayer, "DehakaCoopStage3", c_techCountCompleteOnly) == 0))) {
        TechTreeUpgradeAddLevel(libDF8E6945_gv_dehakaPlayer, "DehakaCoopStage3", 1);
        if ((UnitBehaviorCount(lp_dehaka, "DehakaCoopAirTargetable") == 0)) {
            UnitBehaviorAdd(lp_dehaka, "DehakaCoopAirTargetable", lp_dehaka, 1);
        }
    }
}

void libDF8E6945_gf_DehakaEnsureMinimumLevel (unit lp_dehaka, int lp_minLevel) {
    // Variable Declarations
    int lv_level;
    int lv_guard;

    // Implementation
    if ((lp_dehaka == null)) {
        return;
    }
    // Automatic Variable Declarations
    // Variable Initialization
    lv_level = UnitXPGetCurrentLevel(lp_dehaka, "DehakaVeterancyCoopFinal");
    lv_guard = 0;
    if ((UnitBehaviorCount(lp_dehaka, "DehakaVeterancyCoopFinal") == 0)) {
        UnitBehaviorAdd(lp_dehaka, "DehakaVeterancyCoopFinal", lp_dehaka, 1);
    }
    while ((lv_level < lp_minLevel) && (lv_guard < 4)) {
        UnitXPAddXP(lp_dehaka, "DehakaVeterancyCoopFinal", 15);
        lv_level = UnitXPGetCurrentLevel(lp_dehaka, "DehakaVeterancyCoopFinal");
        lv_guard += 1;
    }
    libDF8E6945_gf_DehakaRefreshLevelState(lp_dehaka);
}

