bool libDF8E6945_gt_DehakaExpAdd_Func (bool testConds, bool runActions) {
    // Variable Declarations
    fixed lv_attribute;

    // Automatic Variable Declarations
    // Variable Initialization
    lv_attribute = UnitGetCustomValue(EventPlayerEffectUsedUnit(c_effectUnitCaster), 63);

    // Actions
    if (!runActions) {
        return true;
    }

    if ((UnitTypeTestAttribute(UnitGetType(EventPlayerEffectUsedUnit(c_effectUnitTarget)), c_unitAttributeMapBoss) == false)) {
        UnitXPAddXP(EventPlayerEffectUsedUnit(c_effectUnitTarget), "DehakaVeterancyCoopFinal", lv_attribute);
        lib67C0F0E7_gf_UnitAddAttributePoint(EventPlayerEffectUsedUnit(c_effectUnitTarget), "DehakaAttEssence", false, FixedToInt(lv_attribute));
        lv_attribute *= 2.0;
        libDF8E6945_gf_DehakaEssenceRecover(EventPlayerEffectUsedUnit(c_effectUnitTarget), lv_attribute);
    }
    else {
        UnitXPAddXP(libDF8E6945_gv_dehaka, "DehakaVeterancyCoopFinal", lv_attribute);
        lib67C0F0E7_gf_UnitAddAttributePoint(libDF8E6945_gv_dehaka, "DehakaAttEssence", false, FixedToInt(lv_attribute));
        lv_attribute *= 2.0;
        libDF8E6945_gf_DehakaEssenceRecover(libDF8E6945_gv_dehaka, lv_attribute);
    }
    return true;
}

