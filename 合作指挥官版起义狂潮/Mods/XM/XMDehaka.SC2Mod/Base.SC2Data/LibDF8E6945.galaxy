    }
    else {
        lv_essence *= 2.0;
        if ((lv_essence < 1)) {
            lv_essence = 1.0;
        }
        else {
            if ((lv_essence >= 10.0)) {
                lv_essence = 12.0;
            }

        }
    }
    auto68FAC787_val = PlayerDifficulty(EventPlayer());
    if (auto68FAC787_val == 1) {
        lv_essence *= 2.0;
    }
    else if (auto68FAC787_val == 2) {
        lv_essence *= 2.0;
    }
    else if (auto68FAC787_val == 3) {
        lv_essence *= 1.5;
    }
    else if (auto68FAC787_val == 4) {
        lv_essence *= 1.0;
    }
    else {
    }
    if (((EventUnitDamageEffect() == "DehakaConsumeImpactEatDamageReal") || (EventUnitDamageEffect() == "DehakaConsumeImpactEatDamageDef"))) {
        UnitXPAddXP(libNtve_gf_KillingUnit(), "DehakaVeterancyCoopFinal", lv_essence);
        lib67C0F0E7_gf_UnitAddAttributePoint(libNtve_gf_KillingUnit(), "DehakaAttEssence", false, FixedToInt(lv_essence));
        lv_essence *= 2.0;
        libDF8E6945_gf_DehakaEssenceRecover(libNtve_gf_KillingUnit(), lv_essence);
        return true;
    }

    libNtve_gf_CreateUnitsWithDefaultFacing(1, "EssenceBuffPickupDehaka", 0, libDF8E6945_gv_dehakaPlayer, UnitGetPosition(EventUnit()));
    auto8B4DF474_g = UnitGroup("EssenceBuffPickupDehaka", libDF8E6945_gv_dehakaPlayer, RegionCircle(UnitGetPosition(UnitLastCreated()), 2.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    auto8B4DF474_u = UnitGroupCount(auto8B4DF474_g, c_unitCountAll);
    for (;; auto8B4DF474_u -= 1) {
