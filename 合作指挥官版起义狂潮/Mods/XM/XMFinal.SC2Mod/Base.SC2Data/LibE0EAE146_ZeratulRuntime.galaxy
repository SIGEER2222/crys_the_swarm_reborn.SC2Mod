bool libE0EAE146_gt_ZeratulArtifactPickedUp_Func (bool testConds, bool runActions) {
    int lv_artifactNumber;

    if (testConds) {
        if (!((libE0EAE146_gv_commander == "Zeratul") && (EventUnit() == libE0EAE146_gv_zeratulArtifact))) {
            return false;
        }
    }

    if (!runActions) {
        return true;
    }

    lv_artifactNumber = libE0EAE146_gv_zeratulArtifactNumber;
    if ((lv_artifactNumber < 1) || (lv_artifactNumber > 3)) {
        return true;
    }

    TechTreeUpgradeAddLevel(1, ("ZeratulArtifactTier" + IntToString(lv_artifactNumber)), 1);
    lib67C0F0E7_gf_ZeratulPanelControl(1, lv_artifactNumber, "Collected");
    libE0EAE146_gv_zeratulArtifact = null;
    if (lv_artifactNumber >= 3) {
        libE0EAE146_gv_zeratulArtifactNumber = 4;
        TechTreeUpgradeAddLevel(1, "ProphecyArtifactsDiscovered", 1);
        DialogControlSetAnimationState(lib67C0F0E7_gv_cU_GPPanel[1], PlayerGroupAll(), "ProphecyState", "NotReady");
        return true;
    }

    libE0EAE146_gv_zeratulArtifactNumber += 1;
    DialogControlSetAnimationState(lib67C0F0E7_gv_cU_GPPanel[1], PlayerGroupAll(), "CurrentArtifact", IntToString(libE0EAE146_gv_zeratulArtifactNumber));
    DialogControlSetAnimationState(lib67C0F0E7_gv_cU_GPPanel[1], PlayerGroupAll(), "ProphecyState", "NotReady");
    Wait(10.0, c_timeGame);
    libE0EAE146_gf_ZeratulPlaceArtifact(1);
    return true;
}

