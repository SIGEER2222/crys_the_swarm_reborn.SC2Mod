void libE0EAE146_gf_AbathurRebornReplaceUnitIfNeeded (unit lp_unit) {
    int lv_player;
    string lv_unitType;
    string lv_replacement;

    if (UnitIsValid(lp_unit) == false) {
        return;
    }
    if (UnitIsAlive(lp_unit) == false) {
        return;
    }

    lv_player = UnitGetOwner(lp_unit);
    if (!((libE0EAE146_gv_commander == "AbathurReborn") && (lv_player == libE0EAE146_gv_abathurRebornRuntimePlayer))) {
        return;
    }

    lv_unitType = UnitGetType(lp_unit);
    lv_replacement = libE0EAE146_gf_AbathurRebornReplacementUnitForBase(lv_player, lv_unitType);
    if ((lv_replacement == "") || (lv_replacement == lv_unitType)) {
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, lv_replacement)) {
        return;
    }

    libNtve_gf_ReplaceUnit(lp_unit, lv_replacement, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
}

void libE0EAE146_gf_AbathurRebornReplaceUnitsOfType (int lp_player, string lp_baseUnit) {
    unitgroup lv_units;
    unit lv_unit;
    string lv_replacement;

    lv_replacement = libE0EAE146_gf_AbathurRebornReplacementUnitForBase(lp_player, lp_baseUnit);
    if ((lv_replacement == "") || (lv_replacement == lp_baseUnit)) {
        return;
    }
    if (!CatalogEntryIsValid(c_gameCatalogUnit, lv_replacement)) {
        return;
    }

    lv_units = UnitGroup(lp_baseUnit, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_unit = UnitGroupUnit(lv_units, 1);
    while (lv_unit != null) {
        if (((UnitIsValid(lv_unit) == true) && (UnitIsAlive(lv_unit) == true)) && (UnitGetOwner(lv_unit) == lp_player)) {
            libNtve_gf_ReplaceUnit(lv_unit, lv_replacement, libNtve_ge_ReplaceUnitOptions_OldUnitsRelative);
        }
        UnitGroupRemove(lv_units, lv_unit);
        lv_unit = UnitGroupUnit(lv_units, 1);
    }
}

