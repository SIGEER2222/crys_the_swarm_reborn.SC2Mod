}

void XMChallenge_EvaluateOnVictory (int lp_player, string lp_mapId, string lp_commanderId) {
    string lv_challenge;
    string lv_key;

    lv_challenge = XMChallenge_Active(lp_player);
    if (lv_challenge == "") {
        return;
    }

    lv_key = lv_challenge + ":" + lp_mapId;
    BankLoad("CampaignXCore", lp_player);
    BankValueSetFromInt(BankLastCreated(), "ChallengeBest", lv_key, FixedToInt(AIGetTime()));
    BankSave(BankLastCreated());

    if (lv_challenge == "ChallengeResourceScarce") {
        XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_RESOURCE_SCARCE_CLEAR");
        XMBlessing_Unlock(lp_player, "BlessingResourceRich");
    }
    else if (lv_challenge == "ChallengeSpeedClear") {
        XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_SPEED_CLEAR");
        XMBlessing_Unlock(lp_player, "BlessingGoldenMinerals");
    }
    else if (lv_challenge == "ChallengeFullBonus") {
        XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_FULL_BONUS_CLEAR");
    }
    else if (lv_challenge == "ChallengeNoHeroDeath") {
        XMAchievement_Unlock(lp_player, "ACH_CHALLENGE_NO_HERO_DEATH_CLEAR");
    }
    libE0EAE146_gf_XMDbgLog("INFO", "CHALLENGE_VICTORY_EVALUATED", "player=" + IntToString(lp_player) + " map=" + lp_mapId + " commander=" + lp_commanderId + " challenge=" + lv_challenge);
}

