void libE0EAE146_gf_KaraxCreateMapStartSquad (string lp_kind, int lp_player, point lp_point) {
    if ((lp_kind == "light")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(4, "Zealot", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "SentryPhasing", 0, lp_player, lp_point);
    }
    else if ((lp_kind == "heavy")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "Zealot", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "SentryPhasing", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "Immortal", 0, lp_player, lp_point);
    }
    else if ((lp_kind == "air")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "Carrier", 0, lp_player, lp_point);
    }
    else if ((lp_kind == "hero")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(3, "Zealot", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "Immortal", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "Colossus", 0, lp_player, lp_point);
    }
    else {
        libNtve_gf_CreateUnitsWithDefaultFacing(4, "Zealot", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "SentryPhasing", 0, lp_player, lp_point);
    }
}

void libE0EAE146_gf_KaraxCreateMapStartSquadInRegion (string lp_kind, int lp_player, region lp_region) {
    libE0EAE146_gf_KaraxCreateMapStartSquad(lp_kind, lp_player, RegionGetCenter(lp_region));
}

void libE0EAE146_gf_KaraxCreateCargoSquad (unit lp_container, string lp_kind) {
    if ((lp_kind == "light")) {
        UnitCargoCreate(lp_container, "Zealot", 4);
        UnitCargoCreate(lp_container, "SentryPhasing", 2);
    }
    else if ((lp_kind == "heavy")) {
        UnitCargoCreate(lp_container, "Zealot", 3);
        UnitCargoCreate(lp_container, "SentryPhasing", 2);
        UnitCargoCreate(lp_container, "Immortal", 2);
    }
    else if ((lp_kind == "air")) {
        UnitCargoCreate(lp_container, "Carrier", 3);
    }
    else if ((lp_kind == "hero")) {
        UnitCargoCreate(lp_container, "Zealot", 3);
        UnitCargoCreate(lp_container, "Immortal", 2);
        UnitCargoCreate(lp_container, "Colossus", 2);
    }
    else {
        libE0EAE146_gf_KaraxCreateCargoSquad(lp_container, "light");
    }
}

