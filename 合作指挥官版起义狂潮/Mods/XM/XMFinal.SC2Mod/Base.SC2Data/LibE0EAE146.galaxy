    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure) == true)) {
        return false;
    }
    lv_type = UnitGetType(lp_unit);
    if ((lv_type == "Roach") || (lv_type == "RoachVile") || (lv_type == "Ravager") || (lv_type == "RavagerAbathur") || (lv_type == "Hydralisk") || (lv_type == "SwarmHostMP") || (lv_type == "Mutalisk") || (lv_type == "GuardianMP") || (lv_type == "Devourer") || (lv_type == "Viper") || (lv_type == "Queen") || (lv_type == "QueenCoop")) {
        return true;
    }
    return false;
}

int libE0EAE146_gf_AbathurBiomassMaxStacks () {
    int lv_max;
    lv_max = 100;
    if ((TechTreeUpgradeCount(1, "CommanderPrestigeAbathurBiomass", c_playerUpgradeCountCompleteOnly) > 0)) {
        lv_max += 25;
    }
    if ((TechTreeUpgradeCount(1, "CommanderPrestigeAbathurUltEvo", c_playerUpgradeCountCompleteOnly) > 0)) {
        lv_max += 100;
    }
    return lv_max;
}

int libE0EAE146_gf_AbathurCurrentBiomass (unit lp_unit) {
    return (UnitBehaviorCount(lp_unit, "BiomassBuff1", c_unitBehaviorCountAll) + (UnitBehaviorCount(lp_unit, "BiomassBuff10", c_unitBehaviorCountAll) * 10) + (UnitBehaviorCount(lp_unit, "BiomassBuff100", c_unitBehaviorCountAll) * 100));
}

void libE0EAE146_gf_AbathurSetBiomass (unit lp_unit, int lp_amount) {
    int lv_amount;
    int lv_cap;
    int lv_hundreds;
    int lv_tens;
    int lv_ones;
    if ((lp_unit == null)) {
        return;
    }
    lv_cap = libE0EAE146_gf_AbathurBiomassMaxStacks();
    lv_amount = MaxI(0, MinI(lp_amount, lv_cap));
    UnitBehaviorRemove(lp_unit, "BiomassBuff1", UnitBehaviorCount(lp_unit, "BiomassBuff1", c_unitBehaviorCountAll));
    UnitBehaviorRemove(lp_unit, "BiomassBuff10", UnitBehaviorCount(lp_unit, "BiomassBuff10", c_unitBehaviorCountAll));
    UnitBehaviorRemove(lp_unit, "BiomassBuff100", UnitBehaviorCount(lp_unit, "BiomassBuff100", c_unitBehaviorCountAll));
    UnitBehaviorRemove(lp_unit, "BiomassMaxedMarker", UnitBehaviorCount(lp_unit, "BiomassMaxedMarker", c_unitBehaviorCountAll));
    lv_hundreds = (lv_amount / 100);
    lv_tens = ((lv_amount % 100) / 10);
    lv_ones = (lv_amount % 10);
    if ((lv_hundreds > 0)) {
        UnitBehaviorAdd(lp_unit, "BiomassBuff100", lp_unit, lv_hundreds);
    }
    if ((lv_tens > 0)) {
        UnitBehaviorAdd(lp_unit, "BiomassBuff10", lp_unit, lv_tens);
    }
    if ((lv_ones > 0)) {
        UnitBehaviorAdd(lp_unit, "BiomassBuff1", lp_unit, lv_ones);
    }
    if ((lv_amount >= lv_cap)) {
        UnitBehaviorAdd(lp_unit, "BiomassMaxedMarker", lp_unit, 1);
    }
    UnitSetCustomValue(lp_unit, 62, IntToFixed(lv_amount));
}

void libE0EAE146_gf_AbathurApplyBiomass (unit lp_unit, int lp_amount) {
    int lv_gain;
    int lv_current;
    if ((lp_unit == null)) {
        return;
    }
    lv_gain = MaxI(lp_amount, 0);
    if ((lv_gain <= 0)) {
        return;
    }
    if ((TechTreeUpgradeCount(1, "MasteryAbathurDoubleBiomass", c_playerUpgradeCountCompleteOnly) > 0)) {
        lv_gain *= 2;
    }
    lv_current = libE0EAE146_gf_AbathurCurrentBiomass(lp_unit);
    libE0EAE146_gf_AbathurSetBiomass(lp_unit, (lv_current + lv_gain));
}

void libE0EAE146_gf_AbathurCreateMapStartSquad (string lp_kind, int lp_player, point lp_point) {
