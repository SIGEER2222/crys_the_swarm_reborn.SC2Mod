        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Ravager", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "SwarmHostMP", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "air")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "Mutalisk", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Corruptor", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "hero")) {
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "RoachVile", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "Hydralisk", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "Queen", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "ultimate")) {
        if ((libE0EAE146_gf_AbathurHasUltimateUnlock() == true)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Brutalisk", 0, lp_player, lp_point);
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Leviathan", 0, lp_player, lp_point);
        }
        else {
            libE0EAE146_gf_AbathurCreateMapStartSquad("heavy", lp_player, lp_point);
        }
    }
    else {
        libE0EAE146_gf_AbathurCreateMapStartSquad("light", lp_player, lp_point);
    }
}

