void libE0EAE146_gf_AbathurBiomassScale (unit lp_biomassUnit, bool lp_instantScale) {
    fixed lv_customScale;

    if ((lp_biomassUnit == null)) {
        return;
    }
    lv_customScale = (UnitGetCustomValue(lp_biomassUnit, 63) / 100.0);
    lv_customScale += 0.8;
    if ((lv_customScale > 1.8)) {
        lv_customScale = 1.8;
    }
    libNtve_gf_SendActorMessageToUnit(lp_biomassUnit, ("SetScale " + FixedToString(lv_customScale, c_fixedPrecisionAny)));
}

void libE0EAE146_gf_AbathurBiomassMerge (unit lp_biomassUnit, int lp_biomassUnitCount) {
    fixed lv_biomassCongealRadius;
    int lv_nearbyBiomassMaxCount;
    unit lv_nearbyBiomassMaxCountUnit;
    unitgroup lv_group;
    int lv_count;
    unit lv_groupUnit;

    if ((lp_biomassUnit == null)) {
        return;
    }
    if ((lp_biomassUnitCount <= 0)) {
        return;
    }

    lv_biomassCongealRadius = 4.0;
    lv_group = UnitGroup("BiomassPickup", UnitGetOwner(lp_biomassUnit), RegionCircle(UnitGetPosition(lp_biomassUnit), lv_biomassCongealRadius), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_count = UnitGroupCount(lv_group, c_unitCountAll);
    for (;; lv_count -= 1) {
        lv_groupUnit = UnitGroupUnitFromEnd(lv_group, lv_count);
        if (lv_groupUnit == null) {
            break;
        }
        if ((lv_groupUnit != lp_biomassUnit) && (UnitHasBehavior2(lv_groupUnit, "BiomassTravelling") == false) && (UnitGetCustomValue(lv_groupUnit, 63) > lv_nearbyBiomassMaxCount)) {
            lv_nearbyBiomassMaxCount = FixedToInt(UnitGetCustomValue(lv_groupUnit, 63));
            lv_nearbyBiomassMaxCountUnit = lv_groupUnit;
        }
    }

    if ((lv_nearbyBiomassMaxCountUnit != null)) {
        libE0EAE146_gf_AbathurBiomassSetStack(lv_nearbyBiomassMaxCountUnit, FixedToInt((UnitGetCustomValue(lv_nearbyBiomassMaxCountUnit, 63) + lp_biomassUnitCount)));
        UnitBehaviorAdd(lp_biomassUnit, "BiomassTravelling", lp_biomassUnit, 1);
        UnitCreateEffectUnit(lp_biomassUnit, "BiomassPickupFullLM", lv_nearbyBiomassMaxCountUnit);
        libE0EAE146_gf_AbathurBiomassScale(lv_nearbyBiomassMaxCountUnit, false);
    }
}
int libE0EAE146_gf_AbathurUnitBiomassStacks (unit lp_unit) {
    if ((lp_unit == null)) {
        return 0;
    }
    return ((UnitBehaviorCount(lp_unit, "BiomassBuff100") * 100) + (UnitBehaviorCount(lp_unit, "BiomassBuff10") * 10) + UnitBehaviorCount(lp_unit, "BiomassBuff1"));
}
int libE0EAE146_gf_AbathurAddBiomassStacks (unit lp_unit, int lp_amount) {
    int lv_max;
    int lv_current;
    int lv_applied;
    int lv_remaining;
    int lv_100;
    int lv_10;
    int lv_1;
    fixed lv_lifeCurrent;
    fixed lv_lifeMax;

    if ((lp_unit == null)) {
        return 0;
    }
    if ((lp_amount <= 0)) {
        return 0;
    }

    lv_max = libE0EAE146_gf_AbathurBiomassMaxStacks();
    lv_current = libE0EAE146_gf_AbathurUnitBiomassStacks(lp_unit);
    lv_applied = lp_amount;
    if (((lv_current + lv_applied) > lv_max)) {
        lv_applied = (lv_max - lv_current);
    }
    if ((lv_applied <= 0)) {
        return 0;
    }

    lv_remaining = lv_applied;
    lv_100 = TruncI((lv_remaining / 100));
    lv_remaining -= (lv_100 * 100);
    lv_10 = TruncI((lv_remaining / 10));
    lv_remaining -= (lv_10 * 10);
    lv_1 = lv_remaining;

    if ((lv_100 > 0)) {
        UnitBehaviorAddPlayer(lp_unit, "BiomassBuff100", UnitGetOwner(lp_unit), lv_100);
    }
    if ((lv_10 > 0)) {
        UnitBehaviorAddPlayer(lp_unit, "BiomassBuff10", UnitGetOwner(lp_unit), lv_10);
    }
    if ((lv_1 > 0)) {
        UnitBehaviorAddPlayer(lp_unit, "BiomassBuff1", UnitGetOwner(lp_unit), lv_1);
    }
    libNtve_gf_SendActorMessageToUnit(lp_unit, ("SetScale " + FixedToString(libE0EAE146_gf_AbathurBiomassVisualScale(lv_current + lv_applied), c_fixedPrecisionAny)));
    lv_lifeCurrent = UnitGetPropertyFixed(lp_unit, c_unitPropLife, c_unitPropCurrent);
    lv_lifeMax = UnitGetPropertyFixed(lp_unit, c_unitPropLifeMax, c_unitPropCurrent);
    libE0EAE146_gf_XMDbgLog("INFO", "ABATHUR_BIOMASS_APPLIED", "unit=" + UnitGetType(lp_unit) + " owner=" + IntToString(UnitGetOwner(lp_unit)) + " applied=" + IntToString(lv_applied) + " total=" + IntToString(lv_current + lv_applied) + " scale=" + FixedToString(libE0EAE146_gf_AbathurBiomassVisualScale(lv_current + lv_applied), c_fixedPrecisionAny) + " life=" + FixedToString(lv_lifeCurrent, c_fixedPrecisionAny) + "/" + FixedToString(lv_lifeMax, c_fixedPrecisionAny) + " b100=" + IntToString(UnitBehaviorCount(lp_unit, "BiomassBuff100")) + " b10=" + IntToString(UnitBehaviorCount(lp_unit, "BiomassBuff10")) + " b1=" + IntToString(UnitBehaviorCount(lp_unit, "BiomassBuff1")));

    return lv_applied;
}

void libE0EAE146_gf_AbathurSetUnitFullBiomass (unit lp_unit) {
    int lv_applied;
    fixed lv_lifeMax;
    fixed lv_lifeCurrent;

    if ((lp_unit == null)) {
