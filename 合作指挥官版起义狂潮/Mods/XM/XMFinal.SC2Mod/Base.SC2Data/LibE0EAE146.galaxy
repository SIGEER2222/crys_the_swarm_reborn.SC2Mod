        return true;
    }
    if ((libE0EAE146_gv_commander != "Abathur") && (libE0EAE146_gv_commander != "AbathurReborn")) {
        return true;
    }
    lv_pickups = UnitGroup("BiomassPickup", 1, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_i = UnitGroupCount(lv_pickups, c_unitCountAlive);
    for (;; lv_i -= 1) {
        lv_pickup = UnitGroupUnitFromEnd(lv_pickups, lv_i);
