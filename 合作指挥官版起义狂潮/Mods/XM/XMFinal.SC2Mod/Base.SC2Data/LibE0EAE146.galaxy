//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_AbathurBiomassDrop_Func (bool testConds, bool runActions) {
    fixed lv_amount;
    unit lv_dead;
    int lv_stack;

    lv_dead = EventUnit();
    if (testConds) {
        if ((libE0EAE146_gf_AbathurCanDropBiomass(lv_dead) == false)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }

    lv_amount = libE0EAE146_gf_AbathurBiomassAmount(lv_dead);
    lv_stack = MaxI(1, FixedToInt(lv_amount));
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BiomassPickup", c_unitCreateIgnorePlacement, libE0EAE146_gv_abathurBiomassPlayer, UnitGetPosition(lv_dead));
    UnitSetCustomValue(UnitLastCreated(), 63, IntToFixed(lv_stack));
    return true;
}

