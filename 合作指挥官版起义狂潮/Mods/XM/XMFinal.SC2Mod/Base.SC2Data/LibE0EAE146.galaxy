void libE0EAE146_gf_XMTestBench_RunStandardBase (int lp_player) {
    int lv_before;
    int lv_after;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        libE0EAE146_gf_XMDbgLog("ERROR", "TEST_PLAYER_INVALID", "player=" + IntToString(lp_player));
        return;
    }

    if (lp_player != 1) {
        libE0EAE146_gf_XMTestBench_AddError(lp_player);
        libE0EAE146_gf_XMDbgLog("ERROR", "TEST_PLAYER_UNSUPPORTED", "player=" + IntToString(lp_player) + " reason=legacy_initialize_hardcodes_player1");
        return;
    }

    lv_before = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    libE0EAE146_gf_XMTestBench_SeedCommanderBank(lp_player, libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    libE0EAE146_gf_Initialize(false);
    libE0EAE146_gf_InitializeBase(PointWithOffsetPolar(libE0EAE146_gf_XMTestBench_GetSafeOriginPoint(lp_player), 8.0, 0.0), 5, null, true);
    lv_after = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    libE0EAE146_gv_xmTestBenchCreated[lp_player] = MaxI(0, (lv_after - lv_before));
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_SCENARIO_ADAPTER", "scenario=standard_base result=adapter_ok reason=legacy_initializebase_adapter cleanup=manual");
}

point libE0EAE146_gf_XMTestBench_GetSafeOriginPoint (int lp_player) {
    point lv_origin;

    lv_origin = PlayerStartLocation(lp_player);
    if (lv_origin != null) {
        return lv_origin;
    }
    return RegionGetCenter(RegionEntireMap());
}

