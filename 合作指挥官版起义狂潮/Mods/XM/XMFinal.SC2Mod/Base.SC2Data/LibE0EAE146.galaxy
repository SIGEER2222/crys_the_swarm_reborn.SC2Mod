// XMFinal split module: commander panel ability test profiles.

bool libE0EAE146_gf_XMTestBench_CheckPanelProfile (int lp_player, string lp_commander, string lp_panelAbilityId, string lp_abilityId, string lp_buttonId, string lp_requirementId, string lp_casterId, string lp_targetMode, string lp_note, point lp_targetPoint) {
    int lv_mineralsBefore;
    int lv_vespeneBefore;
    bool lv_ok;

    lv_mineralsBefore = PlayerGetPropertyInt(lp_player, c_playerPropMinerals);
    lv_vespeneBefore = PlayerGetPropertyInt(lp_player, c_playerPropVespene);
    lv_ok = true;

    if ((lp_abilityId == "") || (!CatalogEntryIsValid(c_gameCatalogAbil, lp_abilityId))) {
        lv_ok = false;
    }
    if ((lp_buttonId != "") && (!CatalogEntryIsValid(c_gameCatalogButton, lp_buttonId))) {
        lv_ok = false;
    }
    if ((lp_requirementId != "") && (!CatalogEntryIsValid(c_gameCatalogRequirement, lp_requirementId))) {
        lv_ok = false;
    }
    if ((lp_casterId != "") && (!CatalogEntryIsValid(c_gameCatalogUnit, lp_casterId))) {
        lv_ok = false;
    }

    if (!lv_ok) {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "PANEL_PROFILE_MISSING");
        libE0EAE146_gf_XMDbgLog("WARN", "PANEL_PROFILE_MISSING", "commander=" + lp_commander + " panel=" + lp_panelAbilityId + " ability=" + lp_abilityId + " button=" + lp_buttonId + " requirement=" + lp_requirementId + " caster=" + lp_casterId + " targetMode=" + lp_targetMode + " note=" + lp_note + " result=missing_catalog_entry");
        return false;
    }

    libE0EAE146_gv_xmTestBenchCreated[lp_player] += 1;
    libE0EAE146_gf_XMTestBench_SetLastEvent(lp_player, "PANEL_PROFILE_HIT");
    libE0EAE146_gf_XMDbgLog("INFO", "PANEL_PROFILE_HIT", "commander=" + lp_commander + " panel=" + lp_panelAbilityId + " ability=" + lp_abilityId + " button=" + lp_buttonId + " requirement=" + lp_requirementId + " targetMode=" + lp_targetMode + " mineralsBefore=" + IntToString(lv_mineralsBefore) + " vespeneBefore=" + IntToString(lv_vespeneBefore) + " caster=" + lp_casterId + " note=" + lp_note + " result=profile_metadata_only reason=actual_cast_not_issued_by_smoke");
    return true;
}

bool libE0EAE146_gf_XMTestBench_RaynorPanelCostSmoke (int lp_player, string lp_panelAbilityId, point lp_targetPoint) {
    bool lv_ok;
    string lv_panel;

    lv_panel = lp_panelAbilityId;
    if ((lv_panel == "") || (lv_panel == "default")) {
        lv_ok = true;
        lv_ok = libE0EAE146_gf_XMTestBench_CheckPanelProfile(lp_player, "Raynor", "hyperion", "VoidCoopSummonHyperion", "SummonHyperionVoid", "", "CoopCasterRaynor", "point", "summon_hyperion", lp_targetPoint) && lv_ok;
        lv_ok = libE0EAE146_gf_XMTestBench_CheckPanelProfile(lp_player, "Raynor", "banshee_airstrike", "BansheeAirstrike", "BansheeAirstrike", "", "CoopCasterRaynor", "point", "summon_dusk_wings", lp_targetPoint) && lv_ok;
        return lv_ok;
    }
    if (lv_panel == "hyperion") {
        return libE0EAE146_gf_XMTestBench_CheckPanelProfile(lp_player, "Raynor", "hyperion", "VoidCoopSummonHyperion", "SummonHyperionVoid", "", "CoopCasterRaynor", "point", "summon_hyperion", lp_targetPoint);
    }
    if ((lv_panel == "banshee") || (lv_panel == "banshee_airstrike")) {
        return libE0EAE146_gf_XMTestBench_CheckPanelProfile(lp_player, "Raynor", "banshee_airstrike", "BansheeAirstrike", "BansheeAirstrike", "", "CoopCasterRaynor", "point", "summon_dusk_wings", lp_targetPoint);
    }

    libE0EAE146_gf_XMDbgLog("INFO", "PANEL_PROFILE_ALIAS_FALLBACK", "commander=Raynor requested=" + lv_panel + " fallback=hyperion");
    return libE0EAE146_gf_XMTestBench_CheckPanelProfile(lp_player, "Raynor", "hyperion", "VoidCoopSummonHyperion", "SummonHyperionVoid", "", "CoopCasterRaynor", "point", "summon_hyperion", lp_targetPoint);
