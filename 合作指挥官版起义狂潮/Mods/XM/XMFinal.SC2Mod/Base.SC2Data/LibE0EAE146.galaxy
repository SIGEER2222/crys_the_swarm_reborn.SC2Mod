}

bool libE0EAE146_gf_XMTestBench_AbathurRoster (int lp_player, string lp_rosterKind) {
    if (!libE0EAE146_gf_XMTestBench_UnitRosterKindSupported(lp_rosterKind)) {
        return false;
    }
    libE0EAE146_gf_XMTestBench_PrepareUnitRoster(lp_player);
    if (lp_rosterKind == "full_units") {
        libE0EAE146_gf_XMTestBench_CreateAbathurRosterUnitAlias(lp_player, "AbathurGuardian", "GuardianMP", 1, lp_rosterKind);
        libE0EAE146_gf_XMTestBench_CreateAbathurRosterUnitAlias(lp_player, "Devourer", "DevourerMP", 2, lp_rosterKind);
        libE0EAE146_gf_XMTestBench_CreateAbathurRosterUnit(lp_player, "Mutalisk", 3, lp_rosterKind);
        libE0EAE146_gf_XMTestBench_CreateBuildingRosterUnit(lp_player, "SpineCrawler", 4, lp_rosterKind);
        libE0EAE146_gf_XMTestBench_CreateBuildingRosterUnit(lp_player, "SporeCrawler", 5, lp_rosterKind);
