    string lv_selected;

    lv_selected = libE0EAE146_gf_XMProgression_BankString(lp_player, "Blessing", "Selected");
    if ((lv_selected != "") && !XMBlessing_IsUnlocked(lp_player, lv_selected)) {
        libE0EAE146_gf_XMDbgLog("WARN", "BLESSING_SELECTED_LOCKED", "player=" + IntToString(lp_player) + " blessing=" + lv_selected);
