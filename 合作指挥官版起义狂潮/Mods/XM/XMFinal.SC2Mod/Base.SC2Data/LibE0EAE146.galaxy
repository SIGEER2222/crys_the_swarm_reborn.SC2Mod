        libNtve_gf_CreateUnitsWithDefaultFacing(1, "ArtanisVoid", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "ZealotAiur", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(2, "Dragoon", 0, lp_player, lp_point);
        libNtve_gf_CreateUnitsWithDefaultFacing(1, "HighTemplar", 0, lp_player, lp_point);
    }
    else if ((lv_kind == "ultimate")) {
        if ((TechTreeUpgradeCount(1, "ArtanisUnlockTempest", c_techCountCompleteOnly) > 0)) {
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "Archon", 0, lp_player, lp_point);
            libNtve_gf_CreateUnitsWithDefaultFacing(1, "ImmortalAiur", 0, lp_player, lp_point);
            libNtve_gf_CreateUnitsWithDefaultFacing(2, "PhoenixAiur", 0, lp_player, lp_point);
        }
        else {
            libE0EAE146_gf_ArtanisCreateMapStartSquad("heavy", lp_player, lp_point);
        }
    }
    else {
        libE0EAE146_gf_ArtanisCreateMapStartSquad("light", lp_player, lp_point);
    }
}

void libE0EAE146_gf_ArtanisCreateMapStartSquadInRegion (string lp_kind, int lp_player, region lp_region) {
    libE0EAE146_gf_ArtanisCreateMapStartSquad(lp_kind, lp_player, RegionGetCenter(lp_region));
}

void libE0EAE146_gf_ArtanisCreateCargoSquad (unit lp_container, string lp_kind) {
    string lv_kind;
    lv_kind = lp_kind;
    if ((lv_kind == "light")) {
        UnitCargoCreate(lp_container, "ZealotAiur", 3);
        UnitCargoCreate(lp_container, "Dragoon", 2);
    }
    else if ((lv_kind == "heavy")) {
        UnitCargoCreate(lp_container, "ZealotAiur", 2);
        UnitCargoCreate(lp_container, "Dragoon", 2);
        UnitCargoCreate(lp_container, "ImmortalAiur", 1);
        UnitCargoCreate(lp_container, "HighTemplar", 1);
    }
    else if ((lv_kind == "air")) {
        UnitCargoCreate(lp_container, "PhoenixAiur", 2);
        UnitCargoCreate(lp_container, "Observer", 1);
    }
    else if ((lv_kind == "hero")) {
        UnitCargoCreate(lp_container, "ArtanisVoid", 1);
        UnitCargoCreate(lp_container, "ZealotAiur", 2);
        UnitCargoCreate(lp_container, "Dragoon", 2);
        UnitCargoCreate(lp_container, "HighTemplar", 1);
    }
    else if ((lv_kind == "ultimate")) {
        UnitCargoCreate(lp_container, "Archon", 1);
        UnitCargoCreate(lp_container, "ImmortalAiur", 1);
        UnitCargoCreate(lp_container, "PhoenixAiur", 2);
    }
    else {
        libE0EAE146_gf_ArtanisCreateCargoSquad(lp_container, "light");
    }
}

