//--------------------------------------------------------------------------------------------------
// Trigger: AbathurBiomassPickup
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_AbathurBiomassPickup_Func (bool testConds, bool runActions) {
    unitgroup lv_pickups;
    unitgroup lv_units;
    unit lv_unit;
    unit lv_pickup;
    int lv_i;
    int lv_j;
    fixed lv_amount;
    if (!runActions) {
        return true;
    }
    if ((libE0EAE146_gv_commander != "Abathur")) {
        return true;
    }
    lv_pickups = UnitGroup("BiomassPickup", 1, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_i = UnitGroupCount(lv_pickups, c_unitCountAlive);
    for (;; lv_i -= 1) {
        lv_pickup = UnitGroupUnitFromEnd(lv_pickups, lv_i);
        if (lv_pickup == null) { break; }
        lv_amount = UnitGetCustomValue(lv_pickup, 63);
        lv_units = UnitGroup(null, 1, RegionCircle(UnitGetPosition(lv_pickup), 2.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_j = UnitGroupCount(lv_units, c_unitCountAlive);
        for (;; lv_j -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_units, lv_j);
            if (lv_unit == null) { break; }
            if ((libE0EAE146_gf_AbathurUnitCanCollectBiomass(lv_unit) == true)) {
                UnitCreateEffectUnit(lv_pickup, "BiomassPickupImpact", lv_unit);
                libE0EAE146_gf_AbathurApplyBiomass(lv_unit, FixedToInt(lv_amount));
                UnitKill(lv_pickup);
                break;
            }
        }
    }
    return true;
}

void libE0EAE146_gt_AbathurBiomassPickup_Init () {
    libE0EAE146_gt_AbathurBiomassPickup = TriggerCreate("libE0EAE146_gt_AbathurBiomassPickup_Func");
    TriggerEnable(libE0EAE146_gt_AbathurBiomassPickup, false);
    TriggerAddEventTimePeriodic(libE0EAE146_gt_AbathurBiomassPickup, 0.5, c_timeGame);
}

