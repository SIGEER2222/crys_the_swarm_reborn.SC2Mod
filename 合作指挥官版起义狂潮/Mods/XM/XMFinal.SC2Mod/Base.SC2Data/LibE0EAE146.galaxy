bool libE0EAE146_gt_AbathurBiomassDrop_Func (bool testConds, bool runActions) {
    fixed lv_amount;
    unit lv_dead;
    lv_dead = EventUnit();
    if (testConds) {
        if ((libE0EAE146_gf_AbathurCanDropBiomass(lv_dead) == false)) {
            return false;
        }
    }
    if (!runActions) {
        return true;
    }
    lv_amount = libE0EAE146_gf_AbathurBiomassAmount(lv_dead);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, "BiomassPickup", 0, 1, UnitGetPosition(lv_dead));
    UnitSetCustomValue(UnitLastCreated(), 63, lv_amount);
    return true;
}

