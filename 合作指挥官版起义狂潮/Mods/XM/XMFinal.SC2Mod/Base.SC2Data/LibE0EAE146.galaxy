    libE0EAE146_gf_XMDbgLog("INFO", "TEST_BUILDING_ALIAS", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " sourceUnitId=" + lp_sourceUnitType + " resolvedUnitId=" + lp_resolvedUnitType + " sourceUnit=" + lp_sourceUnitType + " resolvedUnit=" + lp_resolvedUnitType);
