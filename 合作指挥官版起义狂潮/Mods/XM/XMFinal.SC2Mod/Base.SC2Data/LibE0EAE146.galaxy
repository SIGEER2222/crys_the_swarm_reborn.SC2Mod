string libE0EAE146_gf_XMTestBench_ReportSection (int lp_player) {
    return "TestBench_" + libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]) + "_" + libE0EAE146_gv_xmTestBenchScenario[lp_player];
}

void libE0EAE146_gf_XMTestBench_WriteReportBank (int lp_player) {
    string lv_section;

    if (!libE0EAE146_gf_XMTestBench_PlayerValid(lp_player)) {
        return;
    }

    lv_section = libE0EAE146_gf_XMTestBench_ReportSection(lp_player);
    BankLoad("CampaignXCore", lp_player);
    BankValueSetFromString(BankLastCreated(), lv_section, "Commander", libE0EAE146_gv_xmTestBenchCommander[lp_player]);
    BankValueSetFromString(BankLastCreated(), lv_section, "Normalized", libE0EAE146_gf_NormalizeCommanderId(libE0EAE146_gv_xmTestBenchCommander[lp_player]));
    BankValueSetFromString(BankLastCreated(), lv_section, "Scenario", libE0EAE146_gv_xmTestBenchScenario[lp_player]);
    BankValueSetFromString(BankLastCreated(), lv_section, "Summary", libE0EAE146_gv_xmTestBenchSummary[lp_player]);
    BankValueSetFromString(BankLastCreated(), lv_section, "Trace", libE0EAE146_gv_xmTestBenchTrace[lp_player]);
    BankValueSetFromString(BankLastCreated(), lv_section, "RequestedIds", libE0EAE146_gv_xmTestBenchRequestedIds[lp_player]);
    BankValueSetFromString(BankLastCreated(), lv_section, "ActualIds", libE0EAE146_gv_xmTestBenchActualIds[lp_player]);
    BankValueSetFromString(BankLastCreated(), lv_section, "MissingIds", libE0EAE146_gv_xmTestBenchMissingIds[lp_player]);
    BankValueSetFromInt(BankLastCreated(), lv_section, "Created", libE0EAE146_gv_xmTestBenchCreated[lp_player]);
    BankValueSetFromInt(BankLastCreated(), lv_section, "Missing", libE0EAE146_gv_xmTestBenchMissing[lp_player]);
    BankValueSetFromInt(BankLastCreated(), lv_section, "Warnings", libE0EAE146_gv_xmTestBenchWarnings[lp_player]);
    BankValueSetFromInt(BankLastCreated(), lv_section, "Errors", libE0EAE146_gv_xmTestBenchErrors[lp_player]);
    BankValueSetFromString(BankLastCreated(), lv_section, "LastEvent", libE0EAE146_gv_xmTestBenchLastEvent[lp_player]);
    BankSave(BankLastCreated());
}

point libE0EAE146_gf_XMTestBench_SpawnPoint (int lp_player, int lp_index, fixed lp_radius, fixed lp_spacing) {
    int lv_slotsPerRow;
    int lv_row;
    int lv_col;
    point lv_origin;

    lv_slotsPerRow = 5;
    lv_row = 0;
    lv_col = (lp_index - 1);
    lv_origin = PointWithOffsetPolar(PlayerStartLocation(lp_player), lp_radius, 0.0);
    while (lv_col >= lv_slotsPerRow) {
        lv_col -= lv_slotsPerRow;
        lv_row += 1;
    }
    return PointWithOffsetPolar(PointWithOffsetPolar(lv_origin, (IntToFixed(lv_col) * lp_spacing), 0.0), (IntToFixed(lv_row) * lp_spacing), 270.0);
}

void libE0EAE146_gf_XMTestBench_CreateProfileUnit (int lp_player, string lp_unitType, point lp_point, string lp_rosterKind) {
    int lv_before;
    int lv_after;
    int lv_created;
    int lv_createdIndex;
    int lv_actualCount;
    unitgroup lv_createdGroup;
    unit lv_createdUnit;
    string lv_actualType;
    string lv_actualTypes;

    if (lp_unitType == "") {
        libE0EAE146_gf_XMTestBench_RecordRequestedObject(lp_player, "blank");
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_RecordMissingObject(lp_player, "blank");
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "TEST_PROFILE_OBJECT_MISSING", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=blank");
        return;
    }
    libE0EAE146_gf_XMTestBench_RecordRequestedObject(lp_player, lp_unitType);
    if (!CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType)) {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_RecordMissingObject(lp_player, lp_unitType);
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "TEST_PROFILE_OBJECT_INVALID", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=" + lp_unitType + " reason=missing_catalog_entry");
        return;
    }

    lv_before = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    libNtve_gf_CreateUnitsWithDefaultFacing(1, lp_unitType, c_unitCreateIgnorePlacement, lp_player, lp_point);
    lv_after = libE0EAE146_gf_XMTestBench_CountPlayerUnits(lp_player);
    lv_createdGroup = UnitLastCreatedGroup();
    lv_created = UnitGroupCount(lv_createdGroup, c_unitCountAll);
    if ((lv_created <= 0) && (lv_after > lv_before)) {
        lv_created = MaxI(0, (lv_after - lv_before));
    }
    if (lv_created > 0) {
        lv_actualTypes = "";
        lv_actualCount = 0;
        lv_createdIndex = 1;
        for (; lv_createdIndex <= lv_created; lv_createdIndex += 1) {
            lv_createdUnit = UnitGroupUnit(lv_createdGroup, lv_createdIndex);
            if (lv_createdUnit == null) {
                continue;
            }
            lv_actualType = UnitGetType(lv_createdUnit);
            libE0EAE146_gf_XMTestBench_RecordActualObject(lp_player, lv_actualType);
            lv_actualTypes = libE0EAE146_gf_XMTestBench_AppendCsvValue(lv_actualTypes, lv_actualType);
            lv_actualCount += 1;
            libE0EAE146_gf_XMDbgLog("INFO", "TEST_PROFILE_OBJECT_ACTUAL", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " requestedUnitType=" + lp_unitType + " actualUnitType=" + lv_actualType + " actualIndex=" + IntToString(lv_actualCount));
        }
        if (lv_actualTypes == "") {
            lv_actualTypes = "unknown";
        }
        libE0EAE146_gv_xmTestBenchCreated[lp_player] += lv_created;
        UnitGroupAddUnitGroup(libE0EAE146_gv_xmTestBenchUnits[lp_player], lv_createdGroup);
        libE0EAE146_gf_XMDbgLog("INFO", "TEST_PROFILE_OBJECT_CREATED", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=" + lp_unitType + " requestedUnitType=" + lp_unitType + " actualUnitTypes=" + lv_actualTypes + " count=" + IntToString(lv_created));
    }
    else {
        libE0EAE146_gv_xmTestBenchMissing[lp_player] += 1;
        libE0EAE146_gf_XMTestBench_RecordMissingObject(lp_player, lp_unitType);
        libE0EAE146_gf_XMTestBench_AddWarning(lp_player);
        libE0EAE146_gf_XMDbgLog("WARN", "TEST_PROFILE_OBJECT_NOT_CREATED", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " unitType=" + lp_unitType + " reason=create_returned_no_count_delta");
    }
}

