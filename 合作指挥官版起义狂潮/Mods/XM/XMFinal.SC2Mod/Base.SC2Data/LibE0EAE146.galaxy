void XMBlessing_ApplySelected (int lp_player) {
    string lv_selected;

    libE0EAE146_gf_XMProgression_EnsureTriggers();
    lv_selected = XMBlessing_Selected(lp_player);
    TriggerEnable(libE0EAE146_gt_XMProgressionPhaseRepair, false);
    TriggerEnable(libE0EAE146_gt_XMProgressionCreepRegen, false);

    if (lv_selected == "BlessingPhaseRepair") {
        TriggerEnable(libE0EAE146_gt_XMProgressionPhaseRepair, true);
    }
    else if (lv_selected == "BlessingCreepRegeneration") {
        TriggerEnable(libE0EAE146_gt_XMProgressionCreepRegen, true);
    }
    else if (lv_selected != "") {
        libE0EAE146_gf_XMDbgLog("INFO", "BLESSING_APPLY_STATE_ONLY", "player=" + IntToString(lp_player) + " blessing=" + lv_selected + " reason=effect_deferred");
    }
