    lv_normalized = libE0EAE146_gf_NormalizeCommanderId(lp_commander);
    libE0EAE146_gv_xmRuntimeCommanderOverrideEnabled = true;
    libE0EAE146_gv_xmRuntimeCommanderOverride = lv_normalized;
    libE0EAE146_gv_commander = lv_normalized;
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_COMMANDER_OVERRIDE", "player=" + IntToString(lp_player) + " commander=" + lv_normalized + " achBit=255 mastery=30 bank=not_saved");
}

