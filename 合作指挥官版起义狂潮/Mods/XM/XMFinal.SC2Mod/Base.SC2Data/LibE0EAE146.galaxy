void libE0EAE146_gf_XMProgression_HealPlayerUnits (int lp_player, bool lp_mechanicalOnly, bool lp_biologicalOnly, fixed lp_amount, string lp_event) {
    unitgroup lv_units;
    unit lv_unit;
    fixed lv_life;
    fixed lv_lifeMax;
    bool lv_valid;

    lv_units = UnitGroup(null, lp_player, RegionEntireMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_unit = UnitGroupUnit(lv_units, 1);
    while (lv_unit != null) {
        lv_valid = true;
        if (lp_mechanicalOnly && !UnitTypeTestAttribute(UnitGetType(lv_unit), c_unitAttributeMechanical)) {
            lv_valid = false;
        }
        if (lp_biologicalOnly && !UnitTypeTestAttribute(UnitGetType(lv_unit), c_unitAttributeBiological)) {
            lv_valid = false;
        }
        if (lv_valid) {
            lv_life = UnitGetPropertyFixed(lv_unit, c_unitPropLife, c_unitPropCurrent);
            lv_lifeMax = UnitGetPropertyFixed(lv_unit, c_unitPropLifeMax, c_unitPropCurrent);
            if ((lv_life > 0.0) && (lv_life < lv_lifeMax)) {
                lv_life = lv_life + lp_amount;
                if (lv_life > lv_lifeMax) {
                    lv_life = lv_lifeMax;
                }
                UnitSetPropertyFixed(lv_unit, c_unitPropLife, lv_life);
            }
        }
        UnitGroupRemove(lv_units, lv_unit);
        lv_unit = UnitGroupUnit(lv_units, 1);
    }
}

bool libE0EAE146_gt_XMProgressionPhaseRepair_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libE0EAE146_gf_XMProgression_HealPlayerUnits(1, true, false, 3.0, "BLESSING_PHASE_REPAIR_TICK");
    return true;
}

bool libE0EAE146_gt_XMProgressionCreepRegen_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    libE0EAE146_gf_XMProgression_HealPlayerUnits(1, false, true, 2.0, "BLESSING_CREEP_REGEN_TICK");
    return true;
}

void libE0EAE146_gf_XMProgression_EnsureTriggers () {
    if (libE0EAE146_gv_xmProgressionTriggersReady) {
        return;
    }
    libE0EAE146_gv_xmProgressionTriggersReady = true;
    libE0EAE146_gt_XMProgressionPhaseRepair = TriggerCreate("libE0EAE146_gt_XMProgressionPhaseRepair_Func");
    TriggerAddEventTimePeriodic(libE0EAE146_gt_XMProgressionPhaseRepair, 2.0, c_timeGame);
    TriggerEnable(libE0EAE146_gt_XMProgressionPhaseRepair, false);
    libE0EAE146_gt_XMProgressionCreepRegen = TriggerCreate("libE0EAE146_gt_XMProgressionCreepRegen_Func");
