// Functions
void libE0EAE146_gf_FinishLevel () {
    // Variable Declarations
    string lv_map;
    int lv_i;

    // Automatic Variable Declarations
    const int auto510FA344_ae = 29;
    const int auto510FA344_ai = 1;

    // Variable Initialization
    lv_map = lib67C0F0E7_gf_MapPathName("XM/");

    // Implementation
    BankLoad("CampaignXCore", 1);
    BankValueSetFromInt(BankLastCreated(), "Finished", lv_map, 1);
    BankValueSetFromInt(BankLastCreated(), "Bon", lv_map, MaxI(libE0EAE146_gv_bon, BankValueGetAsInt(BankLastCreated(), "Bon", lv_map)));
    BankSave(BankLastCreated());
    TriggerQueueClear(c_triggerQueueRetain);
    TriggerQueuePause(true);
    UISetWorldVisible(PlayerGroupAll(), false);
    libNtve_gf_HideGameUI(false, PlayerGroupAll());
    UISetCursorVisible(PlayerGroupAll(), true);
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeBattleUI, true);
    UIClearMessages(PlayerGroupAll(), c_messageAreaAll);
    TransmissionClearAll();
    ConversationDataStop();
    SoundStopAllTriggerSounds(false);
    libCamp_gf_SetAllSoundChannelVolumesCampaign(libNtve_ge_VolumeChannelMode_Victory);
    lv_i = 1;
    for ( ; ( (auto510FA344_ai >= 0 && lv_i <= auto510FA344_ae) || (auto510FA344_ai < 0 && lv_i >= auto510FA344_ae) ) ; lv_i += auto510FA344_ai ) {
        if ((lv_map == UserDataGetString("Campaign", "Wol", "MapPathName", lv_i))) {
            VictoryPanelSetMissionText(UserDataGetText("Campaign", "Wol", "MapName", lv_i));
            break;
        }

    }
    VictoryPanelSetMissionTimeTitle(StringExternal("Param/Value/lib_E0EAE146_3D02C191"));
    VictoryPanelSetBackgroundFilePath(UserDataGetImagePath("Campaign", "Wol", "scorescreen", lv_i));
    VictoryPanelSetSummaryBackgroundFilePath(UserDataGetImagePath("Campaign", "Wol", "battlereports", lv_i));
    if ((lv_map == "tzeratul04")) {
        VictoryPanelSetVictoryText(StringExternal("Param/Value/lib_E0EAE146_54CC491A"));
    }
    else {
        VictoryPanelSetVictoryText(StringExternal("Param/Value/lib_E0EAE146_F6A6069C"));
    }
    VictoryPanelSetMissionTimeText(FormatDuration(FixedToInt(AIGetTime())));
    VictoryPanelSetRewardTitle(StringToText(""));
    VictoryPanelSetAchievementsTitle(StringExternal("Param/Value/lib_E0EAE146_16658C1E"));
    VictoryPanelSetMissionTitle(StringExternal("Param/Value/lib_E0EAE146_8E44EBBC"));
    VictoryPanelSetStatisticsTitle(StringExternal("Param/Value/lib_E0EAE146_4CDEE1E2"));
    UISetFrameVisible(PlayerGroupAll(), c_syncFrameTypeVictoryPanel, true);
    GameSetNextMap(("XM/" + ("Launcher")));
}

