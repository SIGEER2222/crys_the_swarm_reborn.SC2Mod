// XMFinal split module: official commander building roster profiles.
// Source authority: commanders/<Commander>/buildings.json + wiki-supported catalog supplements.
// Generated by scripts/sc2/generate-xmfinal-commander-profiles.mjs.

bool libE0EAE146_gf_XMTestBench_BuildingRosterKindSupported (string lp_rosterKind) {
    return (lp_rosterKind == "full_buildings");
}

void libE0EAE146_gf_XMTestBench_PrepareBuildingRoster (int lp_player) {
    PlayerModifyPropertyInt(lp_player, c_playerPropMinerals, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(lp_player, c_playerPropVespene, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(lp_player, c_playerPropSuppliesLimit, c_playerPropOperSetTo, 300);
    PlayerSetState(lp_player, c_playerStateFoodIgnored, true);
}

void libE0EAE146_gf_XMTestBench_CreateBuildingRosterUnit (int lp_player, string lp_unitType, int lp_index, string lp_rosterKind) {
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_BUILDING_UNIT", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_rosterKind + " buildingId=" + lp_unitType + " unitId=" + lp_unitType + " unit=" + lp_unitType + " index=" + IntToString(lp_index));
    libE0EAE146_gf_XMTestBench_CreateProfileUnit(lp_player, lp_unitType, libE0EAE146_gf_XMTestBench_SpawnPoint(lp_player, lp_index, 20.0, 6.0), lp_rosterKind);
}

