//--------------------------------------------------------------------------------------------------
// Trigger: AbathurBiomassPickup
//--------------------------------------------------------------------------------------------------
bool libE0EAE146_gt_AbathurBiomassPickup_Func (bool testConds, bool runActions) {
    unitgroup lv_pickups;
    unitgroup lv_units;
    unit lv_unit;
    unit lv_pickup;
    int lv_i;
    int lv_j;
    fixed lv_amount;
    int lv_stack;
    int lv_applied;

    if (!runActions) {
        return true;
    }
    if ((libE0EAE146_gv_abathurBiomassEnabled == false)) {
        return true;
    }
    if ((libE0EAE146_gv_abathurBiomassEffect == "")) {
        return true;
    }

    lv_pickups = UnitGroup("BiomassPickup", libE0EAE146_gv_abathurBiomassPlayer, RegionPlayableMap(), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
    lv_i = UnitGroupCount(lv_pickups, c_unitCountAlive);
    for (;; lv_i -= 1) {
        lv_pickup = UnitGroupUnitFromEnd(lv_pickups, lv_i);
        if (lv_pickup == null) { break; }
        lv_amount = UnitGetCustomValue(lv_pickup, 63);
        lv_stack = FixedToInt(lv_amount);
        lv_units = UnitGroup(null, libE0EAE146_gv_abathurBiomassPlayer, RegionCircle(UnitGetPosition(lv_pickup), 2.0), UnitFilter(0, 0, (1 << c_targetFilterMissile), (1 << (c_targetFilterDead - 32)) | (1 << (c_targetFilterHidden - 32))), 0);
        lv_j = UnitGroupCount(lv_units, c_unitCountAlive);
        for (;; lv_j -= 1) {
            lv_unit = UnitGroupUnitFromEnd(lv_units, lv_j);
            if (lv_unit == null) { break; }
            if ((UnitTypeTestAttribute(UnitGetType(lv_unit), c_unitAttributeStructure) == false)) {
                lv_applied = libE0EAE146_gf_AbathurAddBiomassStacks(lv_unit, lv_stack);
                if ((lv_applied > 0)) {
                    UnitCreateEffectUnit(lv_pickup, libE0EAE146_gv_abathurBiomassEffect, lv_unit);
                    UnitCreateEffectUnit(lv_pickup, "BiomassPickupFullLM", lv_unit);
                    lib67C0F0E7_gf_UnitAddCustomValue(lv_unit, 62, IntToFixed(lv_applied));
                    if ((lv_applied >= lv_stack)) {
                        UnitKill(lv_pickup);
                    }
                    else {
                        UnitSetCustomValue(lv_pickup, 63, IntToFixed((lv_stack - lv_applied)));
                    }
                }
                break;
            }
        }
    }
    return true;
}

//--------------------------------------------------------------------------------------------------
void libE0EAE146_gt_AbathurBiomassPickup_Init () {
    libE0EAE146_gt_AbathurBiomassPickup = TriggerCreate("libE0EAE146_gt_AbathurBiomassPickup_Func");
    TriggerEnable(libE0EAE146_gt_AbathurBiomassPickup, false);
    TriggerAddEventTimePeriodic(libE0EAE146_gt_AbathurBiomassPickup, 0.5, c_timeGame);
}

