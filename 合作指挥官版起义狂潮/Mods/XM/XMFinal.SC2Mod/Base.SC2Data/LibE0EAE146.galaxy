    libE0EAE146_gv_xmTestBenchRequestedIds[lp_player] = "";
    libE0EAE146_gv_xmTestBenchActualIds[lp_player] = "";
    libE0EAE146_gv_xmTestBenchUnits[lp_player] = UnitGroupEmpty();
