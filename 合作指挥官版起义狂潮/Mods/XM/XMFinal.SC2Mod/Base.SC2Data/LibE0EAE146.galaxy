// XMFinal split module: CommanderTestBench core utilities.

string libE0EAE146_gf_NormalizeCommanderId (string lp_commander) {
    if (lp_commander == "") {
        return "Raynor";
    }
    if ((lp_commander == "Horner") || (lp_commander == "HanHorner") || (lp_commander == "HanAndHorner")) {
        return "Mira";
    }
    if ((lp_commander == "CustomAbathur") || (lp_commander == "AbathurCustom")) {
        return "AbathurCustom";
    }
    return lp_commander;
}

void libE0EAE146_gf_XMDbgLog (string lp_level, string lp_event, string lp_message) {
    TriggerDebugOutput(1, StringToText("[XM_DBG][" + lp_level + "][" + lp_event + "] " + lp_message), false);
}

point libE0EAE146_gf_XMRuntime_GetOriginPoint (int lp_player) {
    point lv_origin;

    if (libE0EAE146_gv_xmRuntimeCommanderOverrideEnabled == true) {
        return RegionGetCenter(RegionEntireMap());
    }
    lv_origin = PlayerStartLocation(lp_player);
    if (lv_origin != null) {
        return lv_origin;
    }
    return RegionGetCenter(RegionEntireMap());
}

bool libE0EAE146_gf_XMTestBench_PlayerValid (int lp_player) {
    if ((lp_player < 1) || (lp_player > libE0EAE146_gv_xmTestBenchMaxPlayers)) {
