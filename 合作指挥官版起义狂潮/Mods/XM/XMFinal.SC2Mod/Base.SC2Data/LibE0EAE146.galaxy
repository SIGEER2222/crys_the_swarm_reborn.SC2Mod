bool libE0EAE146_gf_AbathurCanDropBiomass (unit lp_unit) {
    if ((libE0EAE146_gv_abathurBiomassEnabled == false)) {
        return false;
    }
    if ((lp_unit == null)) {
        return false;
    }
    if ((EventUnitDamageDeathCheck(c_deathTypeRemove) == true)) {
        return false;
    }
    if ((UnitGetOwner(lp_unit) == c_playerAny)) {
        return false;
    }
    if ((libNtve_gf_PlayerIsEnemy(UnitGetOwner(lp_unit), libE0EAE146_gv_abathurBiomassPlayer, libNtve_ge_PlayerRelation_Enemy) == false)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure) == true)) {
        return false;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeSummoned) == true)) {
        return false;
    }
    if ((UnitHasBehavior2(lp_unit, "NoBiomassDrop") == true)) {
        return false;
    }
    if ((libE0EAE146_gf_AbathurBiomassAmount(lp_unit) <= 0.0)) {
        return false;
    }
    return true;
}

fixed libE0EAE146_gf_AbathurBiomassAmount (unit lp_unit) {
    fixed lv_amount;
    fixed lv_food;
    int lv_resourceCost;

    if ((lp_unit == null)) {
        return 0.0;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeHeroic) == true)) {
        lv_amount = 12.0;
    }
    else if ((UnitHasBehavior2(lp_unit, "HybridUnitDummy") == true)) {
        lv_amount = 12.0;
    }
    else if ((UnitHasBehavior2(lp_unit, "CritterExplode") == true)) {
        lv_amount = 1.0;
    }
    else {
        lv_food = StringToFixed(CatalogFieldValueGet(c_gameCatalogUnit, UnitGetType(lp_unit), "Food", libE0EAE146_gv_abathurBiomassPlayer));
        if ((lv_food < 0.0)) {
            lv_amount = (-2.0 * lv_food);
        }
        else {
            lv_amount = UnitGetPropertyInt(lp_unit, c_unitPropSuppliesUsed, c_unitPropNormal);
            if ((lv_amount > 0.0)) {
                lv_amount *= 2.0;
            }
        }

        if ((lv_amount <= 0.0)) {
            lv_resourceCost = UnitTypeGetCost(UnitGetType(lp_unit), c_unitCostSumMineralsVespene);
            if ((lv_resourceCost > 0)) {
                lv_amount = 1.0;
            }
        }

        if ((lv_amount > 0.0)) {
            if ((lv_amount < 1.0)) {
                lv_amount = 1.0;
            }
            if ((lv_amount > 12.0)) {
                lv_amount = 12.0;
            }
        }
    }
    return lv_amount;
}

int libE0EAE146_gf_AbathurBiomassMaxStacks () {
    int lv_max;
    lv_max = CatalogFieldValueGetAsInt(c_gameCatalogEffect, "AbathurBiomassMaxStacksDummy", "Amount", libE0EAE146_gv_abathurBiomassPlayer);
    if ((lv_max <= 0)) {
        lv_max = 100;
    }
    return lv_max;
}

int libE0EAE146_gf_AbathurUnitBiomassStacks (unit lp_unit) {
    if ((lp_unit == null)) {
        return 0;
    }
    return ((UnitBehaviorCount(lp_unit, "BiomassBuff100") * 100) + (UnitBehaviorCount(lp_unit, "BiomassBuff10") * 10) + UnitBehaviorCount(lp_unit, "BiomassBuff1"));
}

int libE0EAE146_gf_AbathurAddBiomassStacks (unit lp_unit, int lp_amount) {
    int lv_max;
    int lv_current;
    int lv_applied;
    int lv_remaining;
    int lv_100;
    int lv_10;
    int lv_1;

    if ((lp_unit == null)) {
        return 0;
    }
    if ((lp_amount <= 0)) {
        return 0;
    }

    lv_max = libE0EAE146_gf_AbathurBiomassMaxStacks();
    lv_current = libE0EAE146_gf_AbathurUnitBiomassStacks(lp_unit);
    lv_applied = lp_amount;
    if (((lv_current + lv_applied) > lv_max)) {
        lv_applied = (lv_max - lv_current);
    }
    if ((lv_applied <= 0)) {
        return 0;
    }

    lv_remaining = lv_applied;
    lv_100 = TruncI((lv_remaining / 100));
    lv_remaining -= (lv_100 * 100);
    lv_10 = TruncI((lv_remaining / 10));
    lv_remaining -= (lv_10 * 10);
    lv_1 = lv_remaining;

    if ((lv_100 > 0)) {
        UnitBehaviorAdd(lp_unit, "BiomassBuff100PlusLife", lp_unit, lv_100);
    }
    if ((lv_10 > 0)) {
        UnitBehaviorAdd(lp_unit, "BiomassBuff10PlusLife", lp_unit, lv_10);
    }
    if ((lv_1 > 0)) {
        UnitBehaviorAdd(lp_unit, "BiomassBuff1", lp_unit, lv_1);
    }

    return lv_applied;
}

void libE0EAE146_gf_AbathurSetUnitFullBiomass (unit lp_unit) {
    int lv_applied;

    if ((lp_unit == null)) {
        return;
    }
    if ((UnitTypeTestAttribute(UnitGetType(lp_unit), c_unitAttributeStructure) == true)) {
        return;
    }
    lv_applied = libE0EAE146_gf_AbathurAddBiomassStacks(lp_unit, libE0EAE146_gf_AbathurBiomassMaxStacks());
    if ((lv_applied > 0)) {
        lib67C0F0E7_gf_UnitAddCustomValue(lp_unit, 62, IntToFixed(lv_applied));
    }
}

void libE0EAE146_gf_AbathurSetUnitGroupFullBiomass (unitgroup lp_units) {
    unit lv_unit;
    int lv_i;

    if ((lp_units == null)) {
        return;
    }
    lv_i = UnitGroupCount(lp_units, c_unitCountAlive);
    for (;; lv_i -= 1) {
        lv_unit = UnitGroupUnitFromEnd(lp_units, lv_i);
        if (lv_unit == null) { break; }
        libE0EAE146_gf_AbathurSetUnitFullBiomass(lv_unit);
    }
}

