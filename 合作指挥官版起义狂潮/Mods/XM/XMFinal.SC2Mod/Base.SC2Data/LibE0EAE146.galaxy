    XMBlessing_LoadSelected(lp_player);
    XMChallenge_LoadActive(lp_player);
    libE0EAE146_gf_XMDbgLog("INFO", "PROGRESSION_INIT", "player=" + IntToString(lp_player) + " blessing=" + XMBlessing_Selected(lp_player) + " challenge=" + XMChallenge_Active(lp_player));
