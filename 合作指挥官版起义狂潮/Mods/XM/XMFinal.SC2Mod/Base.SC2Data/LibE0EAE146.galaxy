    }
    else if (lp_scenarioKind == "special_smoke") {
        libE0EAE146_gf_XMTestBench_RunSpecialSmoke(lp_player);
    }
    else if (lp_scenarioKind == "personal_smoke") {
        libE0EAE146_gf_XMTestBench_RunPersonalSmoke(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_init") {
        libE0EAE146_gf_XMTestBench_AbathurCustomInit(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_zergling_to_pygalisk") {
        libE0EAE146_gf_XMTestBench_AbathurCustomZerglingToPygalisk(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_purchase") {
        libE0EAE146_gf_XMTestBench_AbathurCustomPurchaseSmoke(lp_player);
    }
    else if (lp_scenarioKind == "extra_abathur_crawler") {
        libE0EAE146_gf_XMTestBench_AbathurCustomCrawlerSmoke(lp_player);
    }
    else {
        libE0EAE146_gf_XMTestBench_AddError(lp_player);
        libE0EAE146_gf_XMDbgLog("ERROR", "TEST_SCENARIO_UNKNOWN", "scenario=" + lp_scenarioKind);
    }

    libE0EAE146_gf_XMTestBench_WriteSummary(lp_player);
    libE0EAE146_gf_XMDbgLog("INFO", "TEST_SCENARIO_DONE", "commander=" + libE0EAE146_gv_xmTestBenchCommander[lp_player] + " scenario=" + lp_scenarioKind + " created=" + IntToString(libE0EAE146_gv_xmTestBenchCreated[lp_player]) + " missing=" + IntToString(libE0EAE146_gv_xmTestBenchMissing[lp_player]) + " warnings=" + IntToString(libE0EAE146_gv_xmTestBenchWarnings[lp_player]) + " errors=" + IntToString(libE0EAE146_gv_xmTestBenchErrors[lp_player]));
}

