// XMFinal split module: runtime initialization safety helpers.

void libE0EAE146_gf_SeedDefaultCommanderBankIfEmpty (string lp_defaultCommander) {
    if (lp_defaultCommander == "") {
        return;
    }

    BankLoad("CampaignXCore", 1);
    if (BankValueGetAsString(BankLastCreated(), "Ach", "Commander") == "") {
        BankValueSetFromString(BankLastCreated(), "Ach", "Commander", lp_defaultCommander);
        BankSave(BankLastCreated());
    }
}

string libE0EAE146_gf_CatalogUnitOrEmpty (string lp_unitType) {
    if ((lp_unitType != "") && CatalogEntryIsValid(c_gameCatalogUnit, lp_unitType)) {
        return lp_unitType;
    }

    return "";
}

string libE0EAE146_gf_CommanderAchUnit (string lp_field) {
    string lv_unit;

    // XMCore still defines generic Zagara opener slots, so private openers must win before UserData lookup.
    if (libE0EAE146_gv_commander == "Zagara") {
        if (lp_field == "CommandCenter") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("HatcheryZagara");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "Worker") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("DroneZagara");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
        if (lp_field == "SecondUnit") {
            lv_unit = libE0EAE146_gf_CatalogUnitOrEmpty("OverlordZagara");
            if (lv_unit != "") {
                return lv_unit;
            }
        }
    }

    if (libE0EAE146_gv_commander == "AbathurReborn") {
        if (lp_field == "CommandCenter") {
            return "HatcheryAbathurReborn";
        }
        if (lp_field == "Worker") {
            return "DroneAbathurReborn";
        }
        if (lp_field == "SecondUnit") {
            return "OverlordAbathurReborn";
        }
    }

    lv_unit = UserDataGetUnit("CommanderAch", lib67C0F0E7_gf_StrToUserinstance(libE0EAE146_gv_commander), lp_field, 1);
    if (lv_unit != "") {
        return lv_unit;
    }

    return lv_unit;
}
