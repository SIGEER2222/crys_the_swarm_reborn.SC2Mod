string tb_XMTB_GetCommanderByIndex (int lp_index) {
    if (lp_index == 1) { return "Raynor"; }
    if (lp_index == 2) { return "Kerrigan"; }
    if (lp_index == 3) { return "Artanis"; }
    if (lp_index == 4) { return "Swann"; }
    if (lp_index == 5) { return "Zagara"; }
    if (lp_index == 6) { return "Vorazun"; }
    if (lp_index == 7) { return "Karax"; }
    if (lp_index == 8) { return "Abathur"; }
    if (lp_index == 9) { return "AbathurReborn"; }
    if (lp_index == 10) { return "Alarak"; }
    if (lp_index == 11) { return "Nova"; }
    if (lp_index == 12) { return "Stukov"; }
    if (lp_index == 13) { return "Fenix"; }
    if (lp_index == 14) { return "Dehaka"; }
    if (lp_index == 15) { return "Horner"; }
    if (lp_index == 16) { return "Tychus"; }
    if (lp_index == 17) { return "Zeratul"; }
    if (lp_index == 18) { return "Stetmann"; }
    if (lp_index == 19) { return "Mengsk"; }
    return "Raynor";
}

