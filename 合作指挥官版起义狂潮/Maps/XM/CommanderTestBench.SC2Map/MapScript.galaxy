//==================================================================================================
//
// CommanderTestBench
//
// Dedicated commander smoke-test map.
// UI dispatch stays in the map; gameplay checks live in XMFinal via XMTestBench_*.
//
//==================================================================================================
include "TriggerLibs/NativeLib"
include "TriggerLibs/LibertyLib"
include "TriggerLibs/CampaignLib"
include "Lib67C0F0E7"
include "LibC0F50AA6"
include "Lib81FF3B49"
include "LibDF8E6945"
include "Lib0940FFB7"
include "Lib975E2FE9"
include "LibE0EAE146"
include "LibE0EAE146_h"

//--------------------------------------------------------------------------------------------------
// Library Initialization
//--------------------------------------------------------------------------------------------------
void InitLibs () {
    libNtve_InitLib();
    libLbty_InitLib();
    libCamp_InitLib();
    lib67C0F0E7_InitLib();
    libC0F50AA6_InitLib();
    lib81FF3B49_InitLib();
    libDF8E6945_InitLib();
    lib0940FFB7_InitLib();
    lib975E2FE9_InitLib();
    libE0EAE146_InitLib();
}

//--------------------------------------------------------------------------------------------------
// Constants
//--------------------------------------------------------------------------------------------------
const int gv_xmTbCommanderNum = 19;
const int gv_xmTbScenarioNum = 18;

//--------------------------------------------------------------------------------------------------
// Global Variables
//--------------------------------------------------------------------------------------------------
trigger gt_XMTB_Init;
trigger gt_XMTB_CommanderClick;
trigger gt_XMTB_ScenarioClick;
trigger gt_XMTB_ActionClick;

int gv_xmTbCommanderDialog;
int gv_xmTbScenarioDialog;
int gv_xmTbSummaryDialog;
int gv_xmTbActionDialog;

int[gv_xmTbCommanderNum + 1] gv_xmTbCommanderButton;
int[gv_xmTbScenarioNum + 1] gv_xmTbScenarioButton;
int gv_xmTbButtonClear;
int gv_xmTbButtonRerun;
int gv_xmTbButtonNextCommander;
int gv_xmTbButtonRunAll;
int gv_xmTbSummaryLabel;

string gv_xmTbCurrentCommander;
int gv_xmTbCurrentCommanderIndex;
string gv_xmTbCurrentScenario;
string gv_xmTbLastEvent;

void tb_XMTB_RunBootSmoke ();

void InitGlobals () {
    int lv_i;

    gv_xmTbCommanderDialog = c_invalidDialogId;
    gv_xmTbScenarioDialog = c_invalidDialogId;
    gv_xmTbSummaryDialog = c_invalidDialogId;
    gv_xmTbActionDialog = c_invalidDialogId;
    gv_xmTbSummaryLabel = c_invalidDialogControlId;
    gv_xmTbButtonClear = c_invalidDialogControlId;
    gv_xmTbButtonRerun = c_invalidDialogControlId;
    gv_xmTbButtonNextCommander = c_invalidDialogControlId;
    gv_xmTbButtonRunAll = c_invalidDialogControlId;
    gv_xmTbCurrentCommander = "Raynor";
    gv_xmTbCurrentCommanderIndex = 1;
    gv_xmTbCurrentScenario = "standard_base";
    gv_xmTbLastEvent = "INIT";

    for (lv_i = 0; lv_i <= gv_xmTbCommanderNum; lv_i += 1) {
        gv_xmTbCommanderButton[lv_i] = c_invalidDialogControlId;
    }
    for (lv_i = 0; lv_i <= gv_xmTbScenarioNum; lv_i += 1) {
        gv_xmTbScenarioButton[lv_i] = c_invalidDialogControlId;
    }
}

//--------------------------------------------------------------------------------------------------
