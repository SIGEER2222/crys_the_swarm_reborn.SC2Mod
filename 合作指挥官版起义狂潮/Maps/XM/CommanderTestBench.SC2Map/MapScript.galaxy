int tb_XMTB_FindCommanderIndex (string lp_commander) {
    int lv_i;

    lv_i = 1;
    for (; lv_i <= gv_xmTbCommanderNum; lv_i += 1) {
        if (tb_XMTB_GetCommanderByIndex(lv_i) == lp_commander) {
            return lv_i;
        }
    }
    return 1;
}

void tb_XMTB_UpdateSummary () {
    string lv_summary;
    string lv_preview;
    string lv_text;

    if (gv_xmTbSummaryLabel != c_invalidDialogControlId) {
        lv_summary = XMTestBench_GetSummaryText(1);
        lv_preview = XMTestBench_GetCommanderRosterPreviewText(1);
        lv_text = "当前指挥官：" + tb_XMTB_GetCommanderDisplayByIndex(gv_xmTbCurrentCommanderIndex) + " / " + gv_xmTbCurrentCommander;
        lv_text = lv_text + "\n\n运行摘要：\n" + lv_summary;
        lv_text = lv_text + "\n\n兵种建筑预览：\n" + lv_preview;
        libNtve_gf_SetDialogItemText(gv_xmTbSummaryLabel, StringToText(lv_text), PlayerGroupAll());
    }
}

void tb_XMTB_LoadCommanderFromBank () {
    string lv_saved;

    BankLoad("CampaignXCore", 1);
    lv_saved = BankValueGetAsString(BankLastCreated(), "Ach", "Commander");
    if (lv_saved == "") {
        gv_xmTbCurrentCommander = "Raynor";
    }
    else {
        gv_xmTbCurrentCommander = lv_saved;
    }
    gv_xmTbCurrentCommanderIndex = tb_XMTB_FindCommanderIndex(gv_xmTbCurrentCommander);
    gv_xmTbLastEvent = "INIT";
    TriggerDebugOutput(1, StringToText("[XMTB][INFO] load-commander=" + gv_xmTbCurrentCommander), false);
}

void tb_XMTB_Clear () {
    XMTestBench_Clear(1);
    gv_xmTbLastEvent = "CLEAR";
    tb_XMTB_UpdateSummary();
}

void tb_XMTB_SetCommander (string lp_commander) {
    gv_xmTbCurrentCommander = lp_commander;
    gv_xmTbCurrentCommanderIndex = tb_XMTB_FindCommanderIndex(lp_commander);
    XMTestBench_SetCommander(1, lp_commander);
    XMTestBench_WriteSummary(1);
    gv_xmTbLastEvent = "SET_COMMANDER";
    TriggerDebugOutput(1, StringToText("[XMTB][INFO] set-commander=" + gv_xmTbCurrentCommander), false);
    tb_XMTB_UpdateSummary();
}

void tb_XMTB_RunScenario (string lp_scenario) {
    tb_XMTB_Clear();
    XMTestBench_SetCommander(1, gv_xmTbCurrentCommander);
    XMTestBench_RunScenario(1, lp_scenario);
    XMTestBench_WriteSummary(1);
    gv_xmTbLastEvent = "RUN_SCENARIO";
    TriggerDebugOutput(1, StringToText("[XMTB][INFO] run-scenario=" + lp_scenario + " commander=" + gv_xmTbCurrentCommander), false);
    tb_XMTB_UpdateSummary();
}

void tb_XMTB_RunCurrentScenario () {
    tb_XMTB_RunScenario(gv_xmTbCurrentScenario);
}

void tb_XMTB_RunAllSmoke () {
    gv_xmTbCurrentScenario = "power_fusion";
    tb_XMTB_RunScenario("power_fusion");
    tb_XMTB_RunBootSmoke();
    gv_xmTbLastEvent = "RUN_ALL";
    tb_XMTB_UpdateSummary();
}

void tb_XMTB_RunBootSmoke () {
    gv_xmTbCurrentScenario = "standard_base";
    tb_XMTB_RunScenario("standard_base");
    gv_xmTbCurrentScenario = "full_buildings";
    tb_XMTB_RunScenario("full_buildings");
    gv_xmTbCurrentScenario = "full_units";
    tb_XMTB_RunScenario("full_units");
    gv_xmTbCurrentScenario = "panel_cost_smoke";
    tb_XMTB_RunScenario("panel_cost_smoke");
    gv_xmTbCurrentScenario = "panel_effect_smoke";
    tb_XMTB_RunScenario("panel_effect_smoke");
    gv_xmTbCurrentScenario = "cargo_light";
    tb_XMTB_RunScenario("cargo_light");
    gv_xmTbCurrentScenario = "cargo_heavy";
    tb_XMTB_RunScenario("cargo_heavy");
    gv_xmTbCurrentScenario = "cargo_air";
    tb_XMTB_RunScenario("cargo_air");
    gv_xmTbLastEvent = "RUN_BOOT";
    tb_XMTB_UpdateSummary();
}

//--------------------------------------------------------------------------------------------------
// UI Builders
//--------------------------------------------------------------------------------------------------
void tb_XMTB_BuildCommanderUI () {
    int lv_i;
    int lv_x;
    int lv_y;

    DialogCreate(1540, 150, c_anchorTopLeft, 40, 20, true);
    gv_xmTbCommanderDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbCommanderDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbCommanderDialog, false);

    lv_i = 1;
    lv_x = 0;
    lv_y = 0;
    for (; lv_i <= gv_xmTbCommanderNum; lv_i += 1) {
        libNtve_gf_CreateDialogItemButton(gv_xmTbCommanderDialog, 120, 38, c_anchorTopLeft, lv_x, lv_y, StringToText("切换"), StringToText(tb_XMTB_GetCommanderDisplayByIndex(lv_i)), "");
        gv_xmTbCommanderButton[lv_i] = DialogControlLastCreated();
        lv_x += 126;
        if (lv_x >= 756) {
            lv_x = 0;
            lv_y += 44;
        }
    }
}

void tb_XMTB_BuildScenarioUI () {
    int lv_i;
    int lv_x;
    int lv_y;

    DialogCreate(330, 440, c_anchorLeft, 30, 150, true);
    gv_xmTbScenarioDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbScenarioDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbScenarioDialog, false);

    lv_i = 1;
    lv_x = 0;
    lv_y = 0;
    for (; lv_i <= gv_xmTbScenarioNum; lv_i += 1) {
        libNtve_gf_CreateDialogItemButton(gv_xmTbScenarioDialog, 150, 34, c_anchorTopLeft, lv_x, lv_y, StringToText("运行"), StringToText(tb_XMTB_GetScenarioDisplayByIndex(lv_i)), "");
        gv_xmTbScenarioButton[lv_i] = DialogControlLastCreated();
        if (lv_x == 0) {
            lv_x = 158;
        }
        else {
            lv_x = 0;
            lv_y += 40;
        }
    }
}

void tb_XMTB_BuildSummaryUI () {
    DialogCreate(430, 360, c_anchorRight, 30, 150, true);
    gv_xmTbSummaryDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbSummaryDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbSummaryDialog, false);

    libNtve_gf_CreateDialogItemLabel(gv_xmTbSummaryDialog, 400, 330, c_anchorTopLeft, 15, 15, StringToText("CommanderTestBench 启动中..."), ColorWithAlpha(0, 0, 0, 0), false, 2.0);
    gv_xmTbSummaryLabel = DialogControlLastCreated();
    libNtve_gf_SetDialogItemStyle(gv_xmTbSummaryLabel, "ModCenterSize24", PlayerGroupAll());
}

void tb_XMTB_BuildActionUI () {
    DialogCreate(760, 56, c_anchorTopLeft, 420, 690, true);
    gv_xmTbActionDialog = DialogLastCreated();
    DialogSetVisible(gv_xmTbActionDialog, PlayerGroupAll(), true);
    DialogSetImageVisible(gv_xmTbActionDialog, false);

    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 130, 38, c_anchorLeft, 0, 0, StringToText("清理"), StringToText("清理当前"), "");
    gv_xmTbButtonClear = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 130, 38, c_anchorLeft, 140, 0, StringToText("重跑"), StringToText("重跑当前"), "");
    gv_xmTbButtonRerun = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 160, 38, c_anchorLeft, 280, 0, StringToText("下一位"), StringToText("下一指挥官"), "");
    gv_xmTbButtonNextCommander = DialogControlLastCreated();
    libNtve_gf_CreateDialogItemButton(gv_xmTbActionDialog, 160, 38, c_anchorLeft, 450, 0, StringToText("跑全量"), StringToText("运行当前全量测试"), "");
    gv_xmTbButtonRunAll = DialogControlLastCreated();
}

void tb_XMTB_BuildUI () {
    tb_XMTB_BuildCommanderUI();
    tb_XMTB_BuildScenarioUI();
    tb_XMTB_BuildSummaryUI();
    tb_XMTB_BuildActionUI();
}

//--------------------------------------------------------------------------------------------------
// Triggers
//--------------------------------------------------------------------------------------------------
bool gt_XMTB_Init_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }

    libNtve_gf_HideGameUI(false, PlayerGroupAll());
    UISetWorldVisible(PlayerGroupAll(), true);
    PlayerModifyPropertyInt(1, c_playerPropMinerals, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(1, c_playerPropVespene, c_playerPropOperSetTo, 100000);
    PlayerModifyPropertyInt(1, c_playerPropSuppliesUsed, c_playerPropOperSetTo, 0);
    PlayerModifyPropertyInt(1, c_playerPropSuppliesMade, c_playerPropOperSetTo, 200);

    gv_xmTbCommanderDialog = c_invalidDialogId;
    gv_xmTbScenarioDialog = c_invalidDialogId;
    gv_xmTbSummaryDialog = c_invalidDialogId;
    gv_xmTbActionDialog = c_invalidDialogId;
    gv_xmTbCurrentScenario = "standard_base";
    gv_xmTbLastEvent = "INIT";

    tb_XMTB_LoadCommanderFromBank();
    tb_XMTB_BuildUI();
    XMTestBench_SetCommander(1, gv_xmTbCurrentCommander);
    XMTestBench_WriteSummary(1);
    if (gv_xmTbCurrentCommander == "Kerrigan") {
        gv_xmTbCurrentScenario = "hero_ability_smoke";
        tb_XMTB_RunCurrentScenario();
    }
    else {
        gv_xmTbLastEvent = "INIT_UI";
        tb_XMTB_UpdateSummary();
    }
    return true;
}

bool gt_XMTB_CommanderClick_Func (bool testConds, bool runActions) {
    int lv_i;

    if (!runActions) {
        return true;
    }
    if (DialogControlGetDialog(EventDialogControl()) != gv_xmTbCommanderDialog) {
        return true;
    }

    lv_i = 1;
    for (; lv_i <= gv_xmTbCommanderNum; lv_i += 1) {
        if (EventDialogControl() == gv_xmTbCommanderButton[lv_i]) {
            tb_XMTB_Clear();
            tb_XMTB_SetCommander(tb_XMTB_GetCommanderByIndex(lv_i));
            return true;
        }
    }
    return true;
}

bool gt_XMTB_ScenarioClick_Func (bool testConds, bool runActions) {
    int lv_i;

    if (!runActions) {
        return true;
    }
    if (DialogControlGetDialog(EventDialogControl()) != gv_xmTbScenarioDialog) {
        return true;
    }

    lv_i = 1;
    for (; lv_i <= gv_xmTbScenarioNum; lv_i += 1) {
        if (EventDialogControl() == gv_xmTbScenarioButton[lv_i]) {
            gv_xmTbCurrentScenario = tb_XMTB_GetScenarioByIndex(lv_i);
            tb_XMTB_RunCurrentScenario();
            return true;
        }
    }
    return true;
}

bool gt_XMTB_ActionClick_Func (bool testConds, bool runActions) {
    if (!runActions) {
        return true;
    }
    if (DialogControlGetDialog(EventDialogControl()) != gv_xmTbActionDialog) {
        return true;
    }

    if (EventDialogControl() == gv_xmTbButtonClear) {
        tb_XMTB_Clear();
    }
    else if (EventDialogControl() == gv_xmTbButtonRerun) {
        tb_XMTB_RunCurrentScenario();
    }
    else if (EventDialogControl() == gv_xmTbButtonNextCommander) {
        gv_xmTbCurrentCommanderIndex += 1;
        if (gv_xmTbCurrentCommanderIndex > gv_xmTbCommanderNum) {
            gv_xmTbCurrentCommanderIndex = 1;
        }
        tb_XMTB_Clear();
        tb_XMTB_SetCommander(tb_XMTB_GetCommanderByIndex(gv_xmTbCurrentCommanderIndex));
        tb_XMTB_RunScenario(gv_xmTbCurrentScenario);
    }
    else if (EventDialogControl() == gv_xmTbButtonRunAll) {
        tb_XMTB_RunAllSmoke();
    }
    return true;
}

void gt_XMTB_Init_Init () {
    gt_XMTB_Init = TriggerCreate("gt_XMTB_Init_Func");
    TriggerAddEventMapInit(gt_XMTB_Init);
}

void gt_XMTB_CommanderClick_Init () {
    gt_XMTB_CommanderClick = TriggerCreate("gt_XMTB_CommanderClick_Func");
    TriggerAddEventDialogControl(gt_XMTB_CommanderClick, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

void gt_XMTB_ScenarioClick_Init () {
    gt_XMTB_ScenarioClick = TriggerCreate("gt_XMTB_ScenarioClick_Func");
    TriggerAddEventDialogControl(gt_XMTB_ScenarioClick, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

void gt_XMTB_ActionClick_Init () {
    gt_XMTB_ActionClick = TriggerCreate("gt_XMTB_ActionClick_Func");
    TriggerAddEventDialogControl(gt_XMTB_ActionClick, c_playerAny, c_invalidDialogControlId, c_triggerControlEventTypeClick);
}

//--------------------------------------------------------------------------------------------------
// Trigger Initialization
//--------------------------------------------------------------------------------------------------
void InitTriggers () {
    gt_XMTB_Init_Init();
    gt_XMTB_CommanderClick_Init();
    gt_XMTB_ScenarioClick_Init();
    gt_XMTB_ActionClick_Init();
}

//--------------------------------------------------------------------------------------------------
// Map Initialization
//--------------------------------------------------------------------------------------------------
void InitMap () {
    InitLibs();
    InitGlobals();
    InitTriggers();
}
